.kzc-loading-pulse { animation:kzc-loading-blink 1.2s ease-in-out infinite; }
@keyframes kzc-loading-blink { 0%,100%{opacity:1} 50%{opacity:0.4} }

/* ── ERREUR TIMEOUT ── */
#kzc-timeout-error { display:none;position:fixed;inset:0;z-index:10001;background:rgba(253,252,251,0.97);flex-direction:column;align-items:center;justify-content:center;gap:18px;backdrop-filter:blur(6px);padding:30px; }
#kzc-timeout-error.kzc-visible { display:flex; }
.kzc-error-circle { width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#c0392b,#e74c3c);display:flex;align-items:center;justify-content:center;animation:kzc-ping .6s ease-out forwards; }
@keyframes kzc-ping { 0%{transform:scale(0.6);opacity:0} 60%{transform:scale(1.1);opacity:1} 100%{transform:scale(1);opacity:1} }
.kzc-error-icon { font-size:38px;color:#fff; }
.kzc-error-title { font-size:20px;font-weight:800;color:#1c1c1c;text-align:center; }
.kzc-error-sub { font-size:14px;color:#5a4a30;text-align:center;line-height:1.7;max-width:300px; }
.kzc-error-btn { padding:13px 28px;background:#1c1c1c;color:#fff;border:none;border-radius:12px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;margin-top:6px; }

/* ── CONFIRMATION VERTE ── */
#kzc-confirm-success { display:none;position:fixed;inset:0;z-index:10000;background:rgba(253,252,251,0.97);flex-direction:column;align-items:center;justify-content:center;gap:18px;backdrop-filter:blur(6px); }
#kzc-confirm-success.kzc-visible { display:flex; }
.kzc-success-circle { width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#2d7a2d,#3aa03a);display:flex;align-items:center;justify-content:center;animation:kzc-ping .8s ease-out forwards; }
.kzc-success-check { font-size:38px;color:#fff; }
.kzc-success-title { font-size:20px;font-weight:800;color:#1c1c1c;text-align:center; }
.kzc-success-sub { font-size:14px;color:#5a4a30;text-align:center;line-height:1.6;max-width:280px; }

/* ── POPUP ── */
.kzp-overlay { display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:9998;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(3px); }
.kzp-overlay.kzp-open { display:flex; }
.kzp-modal { background:#fff;border-radius:20px;padding:26px;max-width:480px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 12px 60px rgba(0,0,0,0.2);animation:kzp-in .25s ease; }
@keyframes kzp-in { from{transform:scale(.95);opacity:0} to{transform:scale(1);opacity:1} }
.kzp-title { font-size:18px;font-weight:700;color:#1c1c1c;margin-bottom:18px; }
.kzp-section { margin-bottom:14px; }
.kzp-section-title { font-size:10px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#c9a96e;margin-bottom:8px; }
.kzp-row { display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:6px 0;border-bottom:1px solid #f0ece7;font-size:13px; }
.kzp-label { color:#8a8078;flex-shrink:0; }
.kzp-val { color:#1c1c1c;font-weight:500;text-align:right; }
.kzp-btns { display:flex;gap:10px;margin-top:20px; }
.kzp-btn-cancel { flex:1;padding:13px;border:1.5px solid #e0dbd4;border-radius:12px;background:#fff;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit;color:#5a5249; }
.kzp-btn-confirm { flex:2;padding:13px;border:none;border-radius:12px;background:#1c1c1c;color:#fff;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit; }
.kzp-img-preview { display:block;max-width:100%;max-height:160px;border-radius:10px;margin:0 auto 12px;object-fit:contain;border:1px solid #e0dbd4;background:#f0ede8; }
</style>

<!-- Erreur timeout -->
