  function showRecap(){
    var overlay=document.getElementById('kzp-overlay');
    var body=document.getElementById('kzp-body');
    if(!overlay||!body) return false;
    var html='';
    if(S.cImg) html+='<img src="'+S.cImg+'" class="kzp-img-preview" alt="Aperçu">';

    var variants=getVariants();
    var qteVariant=null;
    variants.forEach(function(v){if(/quant/i.test(v.label)) qteVariant=v;});
    if(qteVariant){
      html+='<div class="kzp-section"><div class="kzp-section-title">Votre commande</div>';
      html+='<div class="kzp-row"><span class="kzp-label">'+qteVariant.label+'</span><span class="kzp-val">'+qteVariant.value+'</span></div>';
      html+='</div>';
    }

    html+='<div class="kzp-section"><div class="kzp-section-title">Caractéristiques du gobelet</div>';
    html+='<div class="kzp-row"><span class="kzp-label">Contenance</span><span class="kzp-val">25/33cl</span></div>';
    html+='<div class="kzp-row"><span class="kzp-label">Coloris</span><span class="kzp-val">Translucide</span></div>';
    html+='</div>';

    body.innerHTML=html;
    overlay.classList.add('kzp-open');
    return true;
  }

  function initCart(){
    var form=document.querySelector('form[action*="/cart/add"]');
    if(!form){setTimeout(initCart,600);return;}
    form.addEventListener('submit',function(e){
      if(window._kzcOrderDone) return;                 // seul submit natif autorisé : après réception du PNG
      e.preventDefault();e.stopPropagation();           // tout autre submit est bloqué : jamais de commande sans PNG
      if(window._kzcPending) return;                    // un flux est déjà en cours
      if(window._kzcPngRequested) return;               // un essai est déjà lancé ; « Réessayer » réarme ce verrou
      updateProps();
      var shown=showRecap();
      if(!shown){confirmOrder(form);return;}
      document.getElementById('kzp-cancel').onclick=function(){document.getElementById('kzp-overlay').classList.remove('kzp-open');};
      document.getElementById('kzp-confirm').onclick=function(){document.getElementById('kzp-overlay').classList.remove('kzp-open');confirmOrder(form);};
    },true);
  }

  function confirmOrder(form){
    var lo=document.getElementById('kzc-loading-overlay');
    var lb=document.getElementById('kzc-loading-bar');
    var ltxt=document.getElementById('kzc-loading-txt');
    var pctEl=document.getElementById('kzc-loading-pct');
    if(lo) lo.classList.add('kzc-active');
    window._kzcPending=true;
    window._kzcPngRequested=true;
    window._kzcLoadInterval=startLoadingAnimation(lb,ltxt,pctEl);

    // ── Boucle de réessai : redemande le PNG au GRAND iframe uniquement,
    //    toutes les 8 s, tant que le viewer n'est pas prêt / que le PNG
    //    n'est pas revenu. S'arrête dès réception de PRINT_PNG_READY.
    function requestPng(){
      if(!window._kzcPending) return;   // déjà résolu → on n'envoie plus rien
      if(!S.vReady) return;             // viewer pas encore prêt → on retentera au prochain tick
      if(iframe&&iframe.contentWindow) iframe.contentWindow.postMessage({type:'REQUEST_PRINT_PNG',proxyUrl:PROXY_URL,proxyKey:PROXY_KEY,origin:'canva'},'*');
    }
    requestPng();                        // tentative immédiate
    window._kzcRetryInterval=setInterval(requestPng,8000);

    // ── Fin de fenêtre : au bout de 60 s sans PNG → message d'erreur + blocage.
    window._kzcTimeout=setTimeout(function(){
      if(window._kzcPending){
        window._kzcPending=false;
        clearInterval(window._kzcLoadInterval);
        clearInterval(window._kzcRetryInterval);
        if(lo) lo.classList.remove('kzc-active');
        showError();
      }
    },60000);
  }

  function maskContenance(){
    document.querySelectorAll('fieldset,.product-form__option').forEach(function(el){
      var txt=(el.getAttribute('data-option-name')||'')+(el.textContent||'');
      if(/contenance/i.test(txt)) el.style.display='none';
    });
  }
  setTimeout(maskContenance,200);
  setTimeout(maskContenance,600);
  setTimeout(maskContenance,1200);
  var _mc=new MutationObserver(function(){maskContenance();});
  _mc.observe(document.body,{childList:true,subtree:true});

  buildForm();
  initCart();
});
</script>
