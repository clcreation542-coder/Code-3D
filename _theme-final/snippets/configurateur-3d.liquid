  function getContenanceAffichee() {
    var allSpans = document.querySelectorAll('span');
    for (var i = 0; i < allSpans.length; i++) {
      var t = allSpans[i].textContent.trim();
      if ((t === '12 / 18 cl' || t === '50 / 60 cl' || t === '25 / 33 cl') && allSpans[i].children.length === 0) return t;
    }
    var labels = document.querySelectorAll('dt, .text-subdued');
    for (var i = 0; i < labels.length; i++) {
      if (labels[i].textContent.trim() === 'Contenance:' || labels[i].textContent.trim() === 'Contenance') {
        var next = labels[i].nextElementSibling;
        if (next && next.textContent.indexOf('cl') !== -1) return next.textContent.trim();
      }
    }
    return '';
  }

  function getQuantiteAffichee() {
    var allSpans = document.querySelectorAll('span');
    for (var i = 0; i < allSpans.length; i++) {
      var t = allSpans[i].textContent.trim();
      var n = parseInt(t, 10);
      if (!isNaN(n) && String(n) === t && n >= 10 && n <= 500 && allSpans[i].children.length === 0) return n;
    }
    return 0;
  }

  function estContenanceRestreinte(c) {
