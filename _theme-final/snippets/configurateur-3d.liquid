      if (document.contains(container)) return;
      // Chercher le titre h1 comme point d'ancrage — stable sur mobile ET desktop
      var h1 = t.querySelector('h1');
      if (h1 && h1.parentNode === t) {
        h1.parentNode.insertBefore(container, h1.nextSibling);
        return;
      }
      var priceBlock = t.querySelector('[data-block-type="price"]');
      if (priceBlock && priceBlock.parentNode === t) { t.insertBefore(container, priceBlock); return; }
      var titleBlock = t.querySelector('[data-block-type="title"]');
