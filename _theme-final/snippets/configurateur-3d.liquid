  function startLoadingAnimation(loadBar, loadText, pctEl) {
    var pct = 0, msgIdx = 0, tick = 0;
    if (loadText) loadText.textContent = LOADING_MESSAGES[0];
    if (loadBar) loadBar.style.width = '0%';
    if (pctEl) pctEl.textContent = '0%';
    // Avance vite au début puis ralentit, mais bouge toujours (min 0,5/pas) :
    // jamais de blocage, et le client voit une vraie progression dès le départ.
    var interval = setInterval(function() {
      if (pct < 99) pct = Math.min(pct + Math.max((99 - pct) * 0.05, 0.5), 99);
      var shown = Math.round(pct);
      if (loadBar) loadBar.style.width = shown + '%';
      if (pctEl) pctEl.textContent = shown + '%';
      // Messages en boucle infinie toutes les ~3 s (15 ticks × 200ms), indépendants
      // du pourcentage : même bloqué à 99 %, le texte continue de tourner.
      tick++;
      if (tick % 15 === 0) {
        msgIdx = (msgIdx + 1) % LOADING_MESSAGES.length;
        if (loadText) loadText.textContent = LOADING_MESSAGES[msgIdx];
      }
    }, 200);
    return interval;
  }

  // ── P6-08 : une propriété = une seule valeur dans le formulaire ──
  function kzRetireProp(form, key) {
    form.querySelectorAll('input[name="properties[' + key + ']"]').forEach(function(el) { el.remove(); });
  }

  // ── P6-10 : photo(s) originale(s) du client, déposées par le viewer ──
  //  Demandée une fois par tentative de commande (si le client a mis au
  //  moins une photo). Le viewer attend la fin du PNG imprimeur avant
  //  d'envoyer la photo. La commande part au plus tard
  //  KZ_PHOTO_ATTENTE_MAX ms après le délai habituel : sans réponse, elle
  //  part sans la propriété (rien n'est bloqué).
  var KZ_PHOTO_ATTENTE_MAX = 8000;
  // Décision d'Allan (23/09) : le PNG imprimeur suffit, on n'envoie PAS la photo
  // originale (ça rallongeait l'ajout au panier). Remettre true pour la réactiver.
  var KZ_PHOTOS_ORIGINALES = false;
  function kzDemandePhotosSources() {
    if (!KZ_PHOTOS_ORIGINALES) return;
    if (window._kzPhotoSrcDemandee) return;
    var zones = Object.keys(window._kuztomPhotoDataUrls || {});
    if (!zones.length || !iframe || !iframe.contentWindow) return;
    window._kzPhotoSrcDemandee = true;
    window._kzPhotoSrcAttente = true;
    iframe.contentWindow.postMessage({ type: 'REQUEST_PHOTO_SOURCES', zoneIds: zones }, VIEWER_ORIGIN);
  }
  function kzPosePhotosSources(urls) {
    window._kzPhotoSrcAttente = false;
    var form = document.querySelector('form[action*="/cart/add"]');
    if (!form || !urls) return;
    Object.keys(urls).forEach(function(zoneId) {
      if (!urls[zoneId]) return;
      var entry = (window._kuztomPhotoFileNames || {})[zoneId];
      var key = '_Photo originale ' + ((entry && entry.label) || zoneId);
      kzRetireProp(form, key);
      var input = document.createElement('input');
      input.type = 'hidden'; input.name = 'properties[' + key + ']'; input.value = urls[zoneId];
      input.setAttribute('data-kz-photo-source', '1');   // hors data-kuztom : non effacé par updateLineItemProperties
      form.appendChild(input);
    });
  }
  // Même délai qu'avant (1,8 s) ; prolongé seulement si une photo originale
  // est en cours d'envoi.
  function kzSoumettreApres(form, delai) {
    var limite = Date.now() + delai + KZ_PHOTO_ATTENTE_MAX;
    setTimeout(function attente() {
      if (window._kzPhotoSrcAttente && Date.now() < limite) { setTimeout(attente, 200); return; }
      window._kuztomOrderDone = true;
      if (form) form.submit();
    }, delai);
  }

  window.addEventListener('message', function(e) {
    if (!kzOrigineViewer(e.origin)) return;   // P2-08
    if (!e.data) return;
    if (e.data.type === 'PHOTO_SOURCES_READY') { kzPosePhotosSources(e.data.urls); return; }
    if (e.data.type === 'kuztom_zone_info') {
      (e.data.zones || []).forEach(function(z) { zoneInfoCache[z.id] = z; });
      updateLineItemProperties(); return;
    }
    if (e.data.type === 'kuztom_ready') {
      if (_kzMiniLoaded && miniIframe && e.source === miniIframe.contentWindow) {
        miniIframe.classList.add('kuztom-ready');
        if (formBuilt) syncAll();
        return;
      }
      viewerReady = true;
      var skel = document.getElementById('kuztom-skeleton');
      if (skel) skel.classList.add('kuztom-skel-hidden');
      var ifr = document.getElementById('kuztom-iframe');
      if (ifr) ifr.classList.add('kuztom-ready');
      var ifrM = document.getElementById('kuztom-mini-iframe');
      if (ifrM) ifrM.classList.add('kuztom-ready');
      post({ type: 'SET_ORDERS_TOKEN', proxyUrl: PROXY_URL, proxyKey: PROXY_KEY });
      if (formBuilt) syncAll(); return;
    }
    if (e.data.type === 'PRINT_PNG_READY') {
      if (!window._kuztomPendingSubmit) return;
      window._kuztomPendingSubmit = false;
      clearInterval(window._kuztomLoadInterval);
      clearInterval(window._kuztomRetryInterval);
      clearTimeout(window._kuztomTimeout);
      var pngUrl = e.data.url;
      var form = document.querySelector('form[action*="/cart/add"]');
      // P6-08 : un seul émetteur. On retire d'abord toute valeur déjà posée
      // (PNG pré-généré par kz-express-guard) pour ne pas envoyer deux
      // « _PNG imprimeur » / « _source » dans la même ligne.
      if (form) { kzRetireProp(form, '_PNG imprimeur'); kzRetireProp(form, '_source'); }
      if (form) injectProp(form, '_PNG imprimeur', pngUrl);
      if (form) injectProp(form, '_source', '3d');
      var loadBar = document.getElementById('kuztom-loading-bar');
      var loadOv  = document.getElementById('kuztom-loading-overlay');
      var loadTxt = document.getElementById('kuztom-loading-text');
      var pctEl   = document.getElementById('kuztom-loading-pct');
      if (loadBar) loadBar.style.width = '100%';
      if (pctEl) pctEl.textContent = '100%';
      if (loadTxt) { loadTxt.textContent = 'Design enregistré ✓'; loadTxt.classList.remove('kuztom-loading-pulse'); }
      if (loadOv) loadOv.classList.remove('kuztom-loading-active');
      var successEl = document.getElementById('kuztom-confirm-success');
      if (successEl) successEl.classList.add('kuztom-visible');
      kzSoumettreApres(form, 1800);   // P6-10 : attend la photo originale si besoin
      return;
    }
    if (e.data.type === 'PRINT_PNG_ERROR') {
      // Un échec ponctuel ne bloque plus la commande : la boucle de réessai
      // va redemander le PNG. Seul le timeout de 60 s déclenche showError().
      return;
    }
  });

