</div>

<style>
  #kzp-overlay { display:none; position:fixed; inset:0; z-index:10000; background:rgba(0,0,0,0.45); align-items:center; justify-content:center; padding:16px; }
  #kzp-overlay.kzp-visible { display:flex; }
  #kzp-modal { background:#fff; border-radius:18px; width:100%; max-width:480px; overflow:hidden; box-shadow:0 24px 64px rgba(0,0,0,0.28); }
  #kzp-drag-handle { display:none; }
  #kzp-top { display:flex; align-items:center; gap:14px; padding:18px 20px 14px; border-bottom:1px solid #f0ede8; }
  #kzp-img-col { flex-shrink:0; width:72px; height:72px; border-radius:10px; overflow:hidden; background:#f7f4f0; }
  #kzp-product-img { width:100%; height:100%; object-fit:cover; display:block; }
  #kzp-title-col { flex:1; }
  #kzp-brand { font-size:10px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#c9a96e; margin:0 0 3px; }
  #kzp-title { font-family:Georgia,serif; font-size:17px; font-weight:700; color:#1c1c1c; margin:0; line-height:1.2; }
  #kzp-subtitle { font-size:11px; color:#bbb; margin:3px 0 0; }
  #kzp-sections { padding:12px 20px 4px; display:flex; flex-direction:column; gap:8px; }
  .kzp-section { border:1.5px solid #ede9e3; border-radius:10px; padding:10px 13px; }
  .kzp-section-title { font-family:Georgia,serif; font-size:12px; font-weight:700; color:#c9a96e; margin-bottom:7px; letter-spacing:0.06em; text-transform:uppercase; }
  .kzp-row { display:flex; justify-content:space-between; align-items:baseline; padding:4px 0; border-bottom:1px solid #f5f2ee; font-size:12.5px; gap:10px; }
  .kzp-row:last-child { border-bottom:none; padding-bottom:0; }
  .kzp-label { color:#999; font-size:12px; flex-shrink:0; }
  .kzp-val { font-weight:600; color:#1c1c1c; text-align:right; }
  .kzp-row--text { display:flex; flex-direction:column; align-items:stretch; padding:6px 0; border-bottom:1px solid #f5f2ee; gap:4px; }
  .kzp-row--text:last-child { border-bottom:none; }
  .kzp-val--text { font-weight:600; color:#1c1c1c; white-space:pre-line; line-height:1.6; font-size:13px; }
  .kzp-dot { display:inline-block; width:10px; height:10px; border-radius:50%; border:1.5px solid #ccc; vertical-align:middle; margin-right:4px; position:relative; top:-1px; }
  #kzp-gold-line { height:1px; background:linear-gradient(90deg,transparent,#c9a96e55,transparent); margin:12px 20px; }
  #kzp-actions { padding:0 20px 20px; display:flex; flex-direction:column; gap:8px; }
  #kzp-confirm-btn { width:100%; padding:13px; background:#1c1c1c; color:#fff; border:none; border-radius:10px; font-size:14px; font-weight:700; letter-spacing:0.04em; cursor:pointer; }
  #kzp-confirm-btn:disabled { background:#888; cursor:not-allowed; }
  @media (max-width:767px) {
    #kzp-overlay { align-items:flex-end; padding:0; }
    #kzp-modal { border-radius:18px 18px 0 0; max-width:100%; }
    #kzp-drag-handle { display:block; width:36px; height:4px; background:#ddd; border-radius:2px; margin:10px auto 0; }
    #kzp-top { padding:12px 16px 12px; }
    #kzp-img-col { width:60px; height:60px; }
    #kzp-title { font-size:16px; }
    #kzp-sections { padding:10px 16px 4px; }
    #kzp-gold-line { margin:10px 16px; }
    #kzp-actions { padding:0 16px 28px; }
  }
</style>

<script>
(function() {
  function kzpGetAllVariants() {
    var results = [];
    var fieldsets = document.querySelectorAll('fieldset.variant-picker__option');
    fieldsets.forEach(function(fs) {
      var legendEl = fs.querySelector('legend');
      var optName = legendEl ? legendEl.textContent.replace(/\s*:.*/, '').trim() : '';
      var checked = fs.querySelector('input[type="radio"]:checked');
      if (checked) {
        var lbl = checked.closest('label');
        if (!lbl && checked.id) lbl = document.querySelector('label[for="' + checked.id + '"]');
        if (lbl) {
          var clone = lbl.cloneNode(true);
          clone.querySelectorAll('.sr-only,.visually-hidden,.kz-unit').forEach(function(el) { el.remove(); });
          var val = clone.textContent.trim();
          if (val && optName) results.push({ label: optName, value: val });
        }
      }
    });
    return results;
  }

  function kzpFmtEuro(cents) {
    return (cents / 100).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
  }

  function kzpGetPrice(variants) {
    var cents = null;
    try {
      var sc = document.querySelector('variant-picker script[data-variant]');
      if (sc && sc.textContent.trim()) {
        var vd = JSON.parse(sc.textContent);
        if (vd && typeof vd.price === 'number') cents = vd.price;
      }
    } catch (e) {}
    try {
      if (window.KZ_PRODUCT && window.KZ_PRODUCT.prices && variants && variants.length >= 2) {
        var k = variants[0].value + '||' + variants[1].value;
        var p = window.KZ_PRODUCT.prices[k];
        if (typeof p === 'number') cents = p;
      }
    } catch (e) {}
    return cents;
  }

  function kzpBuildContent() {
    var productTitle = {{ product.title | json }};
    var fc = document.getElementById('kuztom-injected-fields');
    var colorLabel = fc ? (fc.querySelector('.kuztom-color-label') || {}).textContent : '';
    var colorHex = fc ? ((fc.querySelector('.kuztom-swatch.active') || {}).dataset || {}).color || '' : '';
    var variants = kzpGetAllVariants();
    var prodRows = '';
    prodRows += '<div class="kzp-row"><span class="kzp-label">Produit</span><span class="kzp-val">' + productTitle + '</span></div>';
    variants.forEach(function(v) {
      prodRows += '<div class="kzp-row"><span class="kzp-label">' + v.label + '</span><span class="kzp-val">' + v.value + '</span></div>';
    });
    var kzpCents = kzpGetPrice(variants);
    if (kzpCents !== null) {
      var kzpQty = 0;
      variants.forEach(function(v) { if (/quantit/i.test(v.label)) kzpQty = parseInt(v.value, 10) || 0; });
      var kzpTxt = kzpFmtEuro(kzpCents);
      if (kzpQty > 0) kzpTxt += ' (' + kzpFmtEuro(kzpCents / kzpQty) + ' / gobelet)';
      prodRows += '<div class="kzp-row"><span class="kzp-label">Prix</span><span class="kzp-val">' + kzpTxt + '</span></div>';
    }
    if (colorLabel) prodRows += '<div class="kzp-row"><span class="kzp-label">Couleur gobelet</span><span class="kzp-val"><span class="kzp-dot" style="background:' + colorHex + ';' + (colorHex==='#ffffff'||colorHex==='#FFFFFF'?'box-shadow:0 0 0 1px #e0dbd4;':'') + '"></span>' + colorLabel + '</span></div>';
    var kzpDateEl = document.getElementById('kuztom-event-date');
    if (kzpDateEl && kzpDateEl.value) {
      var kzpD = kzpDateEl.value.split('-');
      var kzpMois = ['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'];
      var kzpDateTxt = (kzpD.length === 3 && kzpMois[parseInt(kzpD[1], 10) - 1]) ? (parseInt(kzpD[2], 10) + ' ' + kzpMois[parseInt(kzpD[1], 10) - 1] + ' ' + kzpD[0]) : kzpDateEl.value;
      prodRows += '<div class="kzp-row"><span class="kzp-label">Date de l’événement</span><span class="kzp-val">' + kzpDateTxt + '</span></div>';
    }
    var persoRows = '';
    if (fc) {
      fc.querySelectorAll('.kuztom-field-group').forEach(function(grp) {
        var lbl = (grp.querySelector('.kuztom-label') || {}).textContent || '';
        var ta = grp.querySelector('.kuztom-textarea');
        var fi = grp.querySelector('input[type="file"][data-zone-id]');
        var uploadText = grp.querySelector('.kuztom-upload-text');
        if (ta && ta.value.trim()) {
          var zoneId = ta.dataset.zoneId || ta.dataset.archZoneId || '';
          var align = (window._kzpZoneAlignCache && window._kzpZoneAlignCache[zoneId]) || ta.dataset.zoneAlign || 'center';
          var safeText = ta.value.trim().replace(/</g, '&lt;').replace(/>/g, '&gt;');
          persoRows += '<div class="kzp-row--text"><span class="kzp-label">' + lbl + '</span><span class="kzp-val--text" style="text-align:' + align + '">' + safeText + '</span></div>';
        } else if (fi && fi.dataset.zoneId && window._kuztomPhotoFileNames[fi.dataset.zoneId] && window._kuztomPhotoFileNames[fi.dataset.zoneId].name) {
          persoRows += '<div class="kzp-row"><span class="kzp-label">' + lbl + '</span><span class="kzp-val">\u2705 ' + window._kuztomPhotoFileNames[fi.dataset.zoneId].name + '</span></div>';
        } else if (uploadText && uploadText.textContent && uploadText.textContent !== 'Choisir une photo') {
          persoRows += '<div class="kzp-row"><span class="kzp-label">' + lbl + '</span><span class="kzp-val">Photo ajout\u00e9e \u2713</span></div>';
        }
      });
    }
    return { prodRows: prodRows, persoRows: persoRows };
  }

  function kzpOpen() {
    var overlay = document.getElementById('kzp-overlay'); if (!overlay) return;
    var c = kzpBuildContent();
    overlay.querySelector('#kzp-prod-rows').innerHTML = c.prodRows;
    var persoSection = overlay.querySelector('#kzp-perso-section');
    if (c.persoRows) { overlay.querySelector('#kzp-perso-rows').innerHTML = c.persoRows; persoSection.style.display = ''; }
    else { persoSection.style.display = 'none'; }
    overlay.classList.add('kzp-visible');
    document.body.style.overflow = 'hidden';
  }

  function kzpClose() {
    var overlay = document.getElementById('kzp-overlay');
    if (overlay) overlay.classList.remove('kzp-visible');
    document.body.style.overflow = '';
  }

  document.addEventListener('click', function(e) {
    var btn = e.target.closest('button[type="submit"][is="custom-button"]');
    if (!btn) return;
    e.preventDefault(); e.stopImmediatePropagation();
    kzpOpen();
  }, true);

  document.addEventListener('DOMContentLoaded', function() {
    var confirmBtn = document.getElementById('kzp-confirm-btn');
    var overlay    = document.getElementById('kzp-overlay');
    if (confirmBtn) confirmBtn.addEventListener('click', function() {
      kzpClose();
      confirmBtn.disabled = true; confirmBtn.textContent = '\u23F3 Pr\u00E9paration de votre commande\u2026';
      var form = document.querySelector('form[action*="/cart/add"]');
      if (form) {
        var allVariants = kzpGetAllVariants();
        var contenanceVariant = null;
        allVariants.forEach(function(v) { if (v.label.toLowerCase().indexOf('contenance') !== -1) contenanceVariant = v; });
        var cv = contenanceVariant ? contenanceVariant.value.toLowerCase() : '';
        if (cv && cv.indexOf('25') === -1 && cv.indexOf('33') === -1) {
          var alertInput = form.querySelector('input[name="properties[_Contenance imprimeur]"]');
          if (!alertInput) { alertInput = document.createElement('input'); alertInput.type = 'hidden'; alertInput.name = 'properties[_Contenance imprimeur]'; form.appendChild(alertInput); }
          alertInput.value = 'Verifier taille : ' + contenanceVariant.value;
        }
        form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
      }
    });
    if (overlay) overlay.addEventListener('click', function(e) { if (e.target === this) kzpClose(); });
  });
})();
</script>
{%- endunless -%}
