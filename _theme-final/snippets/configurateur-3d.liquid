{% comment %}
  Kuztom — Configurateur 3D v5
  Viewer gauche + injection JS des champs dans la colonne droite product-info
{% endcomment %}

{%- assign effective_handle = product.handle -%}
{%- unless product.handle == 'gobelet-personnalise-votre-design' -%}

<style>
  .product-gallery { display:none !important; }
  .product-info__variant-picker .variant-picker__option[data-option-name="Couleur"] { display:none !important; }
  #kuztom-viewer-col { min-width:0; display:flex; flex-direction:column; grid-column:1; grid-row:1; }
  .kuztom-iframe-wrap { position:relative; background:#faf8f5; border-radius:16px; overflow:hidden; box-shadow:0 2px 16px rgba(0,0,0,0.07); }
/* Sur ordinateur, le gobelet reste visible pendant que le formulaire défile. */
@media (min-width:1000px) {
  /* La colonne doit occuper toute la hauteur, sinon le sticky n'a pas de marge pour glisser. */
  #kuztom-viewer-col { align-self:stretch; height:100%; justify-content:flex-start; }
  .kuztom-iframe-wrap { position:sticky; top:90px; z-index:1; flex:0 0 auto; }
}
  .kuztom-iframe-wrap::before { content:''; position:absolute; inset:0; z-index:0; pointer-events:none; background: linear-gradient(to bottom right, transparent calc(50% - 0.6px), rgba(148,136,126,0.38) calc(50% - 0.6px), rgba(148,136,126,0.38) calc(50% + 0.6px), transparent calc(50% + 0.6px)) no-repeat left bottom / 22% 36%, linear-gradient(to bottom left, transparent calc(50% - 0.6px), rgba(148,136,126,0.38) calc(50% - 0.6px), rgba(148,136,126,0.38) calc(50% + 0.6px), transparent calc(50% + 0.6px)) no-repeat right bottom / 22% 36%; }
  .kuztom-iframe-wrap iframe { position:absolute; inset:0; width:100%; height:100%; z-index:1; border:none; display:block; opacity:0; transition:opacity .4s ease; }
  .kuztom-iframe-wrap iframe.kuztom-ready { opacity:1; }
  @keyframes kuztom-spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
  .kuztom-hint { text-align:center; font-size:13px; color:#b8a898; padding:10px 0 14px; letter-spacing:0.06em; margin:6px 0 0 0; border-top:1px solid #ede9e3; }

  #kuztom-skeleton { position:absolute; inset:0; z-index:2; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#faf8f5; transition:opacity .4s ease; }
  #kuztom-skeleton.kuztom-skel-hidden { opacity:0; pointer-events:none; }
  @keyframes kuztom-pulse { 0%,100%{opacity:.45} 50%{opacity:1} }
  .kuztom-skel-gobelet { animation:kuztom-pulse 2s ease-in-out infinite; width:62%; max-width:320px; height:auto; display:block; }
  #kuztom-skel-text { margin-top:18px; font-size:13px; color:#c9a96e; letter-spacing:.08em; font-family:inherit; animation:kuztom-pulse 2s ease-in-out infinite; }

  /* ── LOADING ── */
  #kuztom-loading-overlay { display:none; position:fixed; inset:0; z-index:20000; background:rgba(255,255,255,0.92); flex-direction:column; align-items:center; justify-content:center; gap:16px; backdrop-filter:blur(4px); }
  #kuztom-loading-overlay.kuztom-loading-active { display:flex; }
  #kuztom-loading-bar-wrap { width:260px; height:6px; background:#ede8df; border-radius:3px; overflow:hidden; }
  #kuztom-loading-bar { height:6px; border-radius:3px; background:linear-gradient(90deg,#c9a96e,#e8c87a); width:0%; transition:width .3s ease; }
  #kuztom-loading-text { font-size:14px; color:#1c1c1c; font-family:inherit; letter-spacing:.03em; }
  .kuztom-loading-pulse { animation:kuztom-loading-blink 1.2s ease-in-out infinite; }
  @keyframes kuztom-loading-blink { 0%,100%{opacity:1} 50%{opacity:0.4} }

  /* ── ERREUR TIMEOUT ── */
  #kuztom-timeout-error { display:none; position:fixed; inset:0; z-index:20001; background:rgba(253,252,251,0.97); flex-direction:column; align-items:center; justify-content:center; gap:18px; backdrop-filter:blur(6px); padding:30px; }
  #kuztom-timeout-error.kuztom-visible { display:flex; }
  .kuztom-error-circle { width:80px; height:80px; border-radius:50%; background:linear-gradient(135deg,#c0392b,#e74c3c); display:flex; align-items:center; justify-content:center; animation:kuztom-ping .6s ease-out forwards; }
  @keyframes kuztom-ping { 0%{transform:scale(0.6);opacity:0} 60%{transform:scale(1.1);opacity:1} 100%{transform:scale(1);opacity:1} }
  .kuztom-error-icon { font-size:38px; color:#fff; }
  .kuztom-error-title { font-size:20px; font-weight:800; color:#1c1c1c; text-align:center; }
  .kuztom-error-sub { font-size:14px; color:#5a4a30; text-align:center; line-height:1.7; max-width:300px; }
  .kuztom-error-btn { padding:13px 28px; background:#1c1c1c; color:#fff; border:none; border-radius:12px; font-size:14px; font-weight:700; cursor:pointer; font-family:inherit; margin-top:6px; }

  /* ── CONFIRMATION VERTE ── */
  #kuztom-confirm-success { display:none; position:fixed; inset:0; z-index:20000; background:rgba(253,252,251,0.97); flex-direction:column; align-items:center; justify-content:center; gap:18px; backdrop-filter:blur(6px); }
  #kuztom-confirm-success.kuztom-visible { display:flex; }
  .kuztom-success-circle { width:80px; height:80px; border-radius:50%; background:linear-gradient(135deg,#2d7a2d,#3aa03a); display:flex; align-items:center; justify-content:center; animation:kuztom-ping .8s ease-out forwards; }
  .kuztom-success-check { font-size:38px; color:#fff; }
  .kuztom-success-title { font-size:20px; font-weight:800; color:#1c1c1c; text-align:center; }
  .kuztom-success-sub { font-size:14px; color:#5a4a30; text-align:center; line-height:1.6; max-width:280px; }

  #kuztom-injected-fields { display:flex; flex-direction:column; gap:22px; margin-bottom:8px; }
  .kuztom-field-group { display:flex; flex-direction:column; gap:8px; }
  .kuztom-label { display:block; font-size:12px; font-weight:700; letter-spacing:0.10em; text-transform:uppercase; color:#1c1c1c; margin:0; }
  .kuztom-textarea { width:100%; padding:12px 16px; border:1.5px solid #e0dbd4; border-radius:10px; font-size:16px !important; font-family:inherit; color:#1c1c1c; background:#fdfcfb; outline:none; resize:vertical; min-height:80px; line-height:1.55; transition:border-color 120ms; box-sizing:border-box; }
  .kuztom-textarea:focus { border-color:#c9a96e; }
  .kuztom-upload-label { display:flex; align-items:center; gap:14px; padding:16px; border:1.5px solid #e6dcc9; border-radius:14px; cursor:pointer; font-size:14px; color:#555; background:#faf7f2; transition:border-color 120ms,background 120ms; user-select:none; width:100%; box-sizing:border-box; }
  .kuztom-upload-label:hover { border-color:#c9a96e; background:#fdf9f2; }
  .kuztom-file-input { position:absolute; width:1px; height:1px; overflow:hidden; opacity:0; pointer-events:none; }
  .kuztom-crop-controls { margin-top:10px; padding:12px 14px; background:#fafaf8; border:1px solid #e8e2db; border-radius:8px; }
  .kuztom-crop-row { display:flex; align-items:center; gap:6px; margin-bottom:10px; flex-wrap:wrap; }
  .kuztom-crop-lbl { font-size:12px; color:#888; min-width:75px; }
  .kuztom-crop-btn { width:34px; height:34px; border:1px solid #c4bfb9; border-radius:6px; background:#fff; cursor:pointer; font-size:16px; display:flex; align-items:center; justify-content:center; color:#555; padding:0; }
  .kuztom-crop-btn:hover { background:#f5f0eb; border-color:#c9a96e; }
  .kuztom-crop-zoom { flex:1; min-width:80px; accent-color:#c9a96e; }
  .kuztom-crop-reset { font-size:12px; color:#888; background:none; border:none; cursor:pointer; padding:2px 0; text-decoration:underline; display:block; margin-top:4px; }
  .kuztom-swatches { display:flex; flex-wrap:wrap; gap:10px; }
  .kuztom-swatch { width:32px; height:32px; border-radius:50%; border:2px solid transparent; cursor:pointer; padding:0; outline:none; box-shadow:0 1px 4px rgba(0,0,0,0.22); transition:transform 120ms,border-color 120ms; flex-shrink:0; }
  .kuztom-swatch:hover { transform:scale(1.15); }
  .kuztom-swatch.active { border-color:#1c1c1c; }
  .kuztom-swatch.kuztom-swatch-disabled { opacity:0.25; cursor:not-allowed; pointer-events:none; transform:none !important; filter:grayscale(1); }
  .kuztom-color-label { font-size:13px; color:#555; margin-top:6px; font-style:italic; }
  .kuztom-info-msg { font-size:12px; color:#8a8078; line-height:1.6; padding:4px 0; margin:0; }

  .kuztom-alert { padding:12px 16px; background:#fffaf2; border:1.5px solid #c9a96e; border-radius:10px; font-size:13px; color:#7a5c2e; line-height:1.6; margin-top:4px; }
  #kuztom-bloc-error { display:none; }
  #kuztom-bloc-error.visible { display:block; }

  /* ── CROP OVERLAY MOBILE ── */
  #kuztom-crop-overlay { display:none; width:100%; background:#faf8f5; padding:10px 12px; border:1px solid #e8e2db; border-radius:0 0 14px 14px; box-sizing:border-box; }
  #kuztom-crop-overlay .kuztom-crop-row { display:flex; align-items:center; gap:6px; margin-bottom:8px; flex-wrap:wrap; }
  #kuztom-crop-overlay .kuztom-crop-lbl { font-size:12px; color:#555; min-width:60px; }
  #kuztom-crop-overlay .kuztom-crop-btn { width:40px; height:40px; border:1px solid #c4bfb9; border-radius:6px; background:#fff; cursor:pointer; font-size:20px; display:flex; align-items:center; justify-content:center; color:#555; padding:0; }
  #kuztom-crop-overlay .kuztom-crop-zoom { flex:1; min-width:80px; accent-color:#c9a96e; }

  /* ── MINI VIEWER : rond 144px ── */
  #kuztom-mini-viewer {
    display:none; position:fixed; top:10px; left:50%; transform:translateX(-50%);
    width:144px; height:144px; border-radius:50%;
    border:2.5px solid #c9a96e;
    background:rgba(255,255,255,0.72);
    backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px);
    box-shadow:0 4px 20px rgba(201,169,110,0.25), 0 2px 8px rgba(0,0,0,0.1);
    overflow:hidden; cursor:pointer; z-index:9999;
  }
  #kuztom-mini-iframe { position:absolute; top:0; left:-1px; width:686px !important; height:686px !important; transform:scale(0.21); transform-origin:top left; pointer-events:none; border:none; }
  @media (max-width:767px) { #kuztom-viewer-col { width:100%; flex:none; } .kuztom-iframe-wrap { height:100vw; max-height:420px; min-height:320px; } }
  @media (min-width:768px) { #kuztom-mini-viewer { display:none !important; } }
  /* Le mini-aperçu flottant passait par-dessus le récapitulatif : on le masque tant que la modale est ouverte. */
  body:has(#kzp-overlay.kzp-visible) #kuztom-mini-viewer { display:none !important; }
</style>

<!-- Erreur timeout -->
<div id="kuztom-timeout-error">
  <div class="kuztom-error-circle"><span class="kuztom-error-icon">⚠️</span></div>
  <div class="kuztom-error-title">Connexion trop lente</div>
  <div class="kuztom-error-sub">Votre design n'a pas pu être transmis à l'imprimeur. Cela arrive parfois avec une connexion lente ou instable.<br><br>Votre commande n'a pas été passée. Reconnectez-vous à un meilleur réseau (Wi-Fi de préférence) et réessayez.</div>
  <button class="kuztom-error-btn" id="kuztom-error-retry">Réessayer</button>
</div>

<!-- Confirmation verte -->
<div id="kuztom-confirm-success">
  <div class="kuztom-success-circle"><span class="kuztom-success-check">✓</span></div>
  <div class="kuztom-success-title">✅ Votre design est enregistré et prêt pour l'impression.</div>
  <div class="kuztom-success-sub">Dernière étape : validez votre commande pour lancer la production.</div>
</div>

<div id="kuztom-loading-overlay">
  <div style="display:flex;align-items:center;gap:10px;width:260px;">
    <div id="kuztom-loading-bar-wrap" style="flex:1;"><div id="kuztom-loading-bar"></div></div>
    <span id="kuztom-loading-pct" style="font-size:12px;color:#c9a96e;font-weight:700;min-width:36px;text-align:right;">0%</span>
  </div>
  <div id="kuztom-loading-text" class="kuztom-loading-pulse">Préparation de votre commande en cours...</div>
</div>

{%- assign jdgm_rating = product.metafields.judge_me.rating.value -%}
{%- assign jdgm_count = product.metafields.judge_me.rating_count.value -%}
{%- if jdgm_rating != blank and jdgm_count != blank and jdgm_count > 0 -%}
<style>
#kuztom-rating-bar { display:flex;align-items:center;gap:6px;margin-bottom:8px;flex-wrap:wrap; }
.kuztom-stars { display:inline-flex;align-items:center;gap:2px; }
.kuztom-stars svg { width:16px;height:16px; }
.kuztom-rating-count { font-size:13px;color:#8a8078; }
</style>
<div id="kuztom-rating-bar">
  <div class="kuztom-stars">
    {%- assign rating_rounded = jdgm_rating | round -%}
    {%- for i in (1..5) -%}
      {%- if i <= rating_rounded -%}
        <svg viewBox="0 0 24 24" fill="#E3D431" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      {%- else -%}
        <svg viewBox="0 0 24 24" fill="#e0dbd4" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <span class="kuztom-rating-count">{{ jdgm_count }} avis</span>
</div>
<script>
(function() {
  function placeRating() {
    var bar = document.getElementById('kuztom-rating-bar');
    if (!bar) return;
    var pi = document.querySelector('.product-info');
    if (!pi) { setTimeout(placeRating, 200); return; }
    var titleBlock = pi.querySelector('[data-block-type="title"]');
    if (titleBlock) { titleBlock.parentNode.insertBefore(bar, titleBlock.nextSibling); return; }
    var h1 = pi.querySelector('h1');
    if (h1) { h1.parentNode.insertBefore(bar, h1.nextSibling); return; }
    pi.prepend(bar);
  }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', placeRating); }
  else { setTimeout(placeRating, 100); }
})();
</script>
{%- endif -%}

<div id="kuztom-viewer-col">
  <div class="kuztom-iframe-wrap" id="kuztom-iframe-wrap">
    <iframe id="kuztom-iframe" title="Aperçu 3D de votre gobelet"></iframe>
    <div id="kuztom-skeleton">
      <svg class="kuztom-skel-gobelet" viewBox="0 0 300 420" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="kug-body" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#d0cdc8"/><stop offset="18%" stop-color="#e8e5e0"/>
            <stop offset="42%" stop-color="#f5f3ef"/><stop offset="58%" stop-color="#f5f3ef"/>
            <stop offset="82%" stop-color="#e2dfd9"/><stop offset="100%" stop-color="#c8c5c0"/>
          </linearGradient>
          <linearGradient id="kug-shine" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.5"/>
            <stop offset="40%" stop-color="#ffffff" stop-opacity="0.2"/>
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
          </linearGradient>
          <radialGradient id="kug-shadow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#b0aca8" stop-opacity="0.3"/>
            <stop offset="100%" stop-color="#b0aca8" stop-opacity="0"/>
          </radialGradient>
          <clipPath id="kug-clip">
            <path d="M72 42 L228 42 L206 372 Q204 382 188 384 L112 384 Q96 382 94 372 Z"/>
          </clipPath>
        </defs>
        <ellipse cx="150" cy="392" rx="72" ry="11" fill="url(#kug-shadow)"/>
        <path d="M72 42 L228 42 L206 372 Q204 382 188 384 L112 384 Q96 382 94 372 Z" fill="url(#kug-body)"/>
        <rect x="72" y="42" width="60" height="342" fill="url(#kug-shine)" clip-path="url(#kug-clip)"/>
        <ellipse cx="150" cy="42" rx="78" ry="7" fill="#e8e5e0" stroke="#c0bcb8" stroke-width="1"/>
        <ellipse cx="150" cy="42" rx="68" ry="5" fill="#ccc9c4"/>
      </svg>
      <div id="kuztom-skel-text">Votre gobelet personnalisé arrive en 3D...</div>
    </div>
  </div>
  <!-- CROP OVERLAY MOBILE : sous le viewer -->
  <div id="kuztom-crop-overlay">
    <div class="kuztom-crop-row">
      <span class="kuztom-crop-lbl">&#128269; Zoom</span>
      <button type="button" class="kuztom-crop-btn" id="kco-zm">&minus;</button>
      <input type="range" class="kuztom-crop-zoom" id="kco-slider" min="50" max="300" value="100" step="5">
      <button type="button" class="kuztom-crop-btn" id="kco-zp">+</button>
    </div>
    <div class="kuztom-crop-row" style="margin-bottom:0;justify-content:center;">
      <button type="button" class="kuztom-crop-btn" id="kco-l" style="display:flex;align-items:center;justify-content:center;">&#9664;</button>
      <button type="button" class="kuztom-crop-btn" id="kco-r" style="display:flex;align-items:center;justify-content:center;">&#9654;</button>
      <button type="button" class="kuztom-crop-btn" id="kco-u" style="display:flex;align-items:center;justify-content:center;">&#9650;</button>
      <button type="button" class="kuztom-crop-btn" id="kco-d" style="display:flex;align-items:center;justify-content:center;">&#9660;</button>
      <button type="button" id="kuztom-crop-validate" style="flex:1;margin:0;padding:8px 6px;background:#c9a96e;color:#fff;border:none;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;">Valider</button>
    </div>
  </div>
  <p class="kuztom-hint"><span style="display:inline-block;animation:kuztom-spin 3s linear infinite">&#8635;</span> &nbsp;Explorer &agrave; 360&deg;</p>
</div>

<div id="kuztom-mini-viewer">
  <iframe id="kuztom-mini-iframe" title="Mini aperçu gobelet"></iframe>
</div>

<script>
(function () {
  // ══════════════════════════════════════════════════════════════
  //  KZ_LAYOUT v5 — SOURCE DE VÉRITÉ UNIQUE
  //  ⚠️ Bloc DUPLIQUÉ À L'IDENTIQUE dans :
  //       kuztom-admin.html · configurateur-viewer.html · configurateur-3d.liquid
  //     Toute modif doit être reportée dans les trois + version incrémentée.
  //  Ici il sert à décider si le texte du client rentre encore (MIN_FONT_PX).
  //  Il DOIT donner le même résultat que le viewer, sinon on bloque la frappe
  //  sur des textes qui passaient, ou on en laisse passer qui débordent.
  //
  //  06/09/2026 — REMISE À NIVEAU v2 → v5.
  //  Ce fichier était resté en v2 (décrément linéaire de 2 px, test de
  //  hauteur autour d'un ancrage figé au milieu du cadratin) pendant que le
  //  viewer et l'admin passaient en v5 (mesure sur l'ENCRE réelle +
  //  dichotomie + test d'ellipse exact). Les deux ne rendaient plus le même
  //  chiffre : sur « Alexis » dans une zone de 550×79 plafonnée à 102 px,
  //  la v2 répondait 88 px là où le viewer en dessinait 102. Le garde-fou
  //  bloquait donc la frappe plus tôt que nécessaire, sur des textes qui
  //  passaient très bien. Le commentaire « source de vérité unique » était
  //  devenu faux ; il redevient vrai.
  // ══════════════════════════════════════════════════════════════
  var KZ_LAYOUT_VERSION = 5;   // v3 : COURBURE (zone.curve) · v5 : ellipse exacte (KZ_fits)
  var KZ_FS_MIN = 8;   // plancher commun (l'admin était à 6, le viewer à 8)
  var KZ_FS_STEP = 2;
  var _kzMeasureCtx = document.createElement('canvas').getContext('2d');

  // ── v4 : mesure sur l'ENCRE + dichotomie ────────────────────────────
  // Avant : on partait du plafond et on descendait de 2 px, et le test de
  // hauteur était fait autour d'un ancrage FIGÉ (milieu du cadratin).
  // Comme l'encre n'est pas symétrique autour de cet ancrage (hampes et
  // accents en haut, presque rien en bas pour des chiffres), le texte
  // butait en haut alors qu'il restait du vide en bas — vide inutilisable.
  // Maintenant : on mesure la hauteur d'encre réelle, on la centre, et on
  // cherche la plus grande taille par dichotomie au pixel près.
  var KZ_INK_CENTER = true;    // ⚠️ BLOC MIROIR : même valeur dans le viewer
  var KZ_INK_SW     = 3;       // marge réservée au contour

  function KZ_ink(ctx, zone, text, fs) {
    var lines = String(text == null ? '' : text).split('\n');
    var lh    = zone.lineHeight || 1.3;
    var lineH = fs * lh;
    ctx.font = fs + "px '" + (zone.font_family || 'Jost') + "'";
    ctx.textBaseline = 'middle';
    ctx.textAlign    = 'left';
    var mF = ctx.measureText(lines[0] || ' ');
    var mL = ctx.measureText(lines[lines.length - 1] || ' ');
    var asc  = (mF.actualBoundingBoxAscent  !== undefined) ? mF.actualBoundingBoxAscent  : fs * 0.35;
    var desc = (mL.actualBoundingBoxDescent !== undefined) ? mL.actualBoundingBoxDescent : fs * 0.35;
    var w = 0;
    for (var i = 0; i < lines.length; i++) {
      var m  = ctx.measureText(lines[i] || ' ');
      var lw = (m.actualBoundingBoxLeft !== undefined && m.actualBoundingBoxRight !== undefined)
             ? (Math.abs(m.actualBoundingBoxLeft) + Math.abs(m.actualBoundingBoxRight)) : m.width;
      if (lw > w) w = lw;
    }
    return { w: w, h: asc + (lines.length - 1) * lineH + desc, asc: asc, desc: desc };
  }

  // Décalage vertical à appliquer au dessin pour centrer sur l'encre.
  function KZ_inkShift(ctx, zone, text, fs) {
    if (!KZ_INK_CENTER) return 0;
    var prevF = ctx.font, prevB = ctx.textBaseline, prevA = ctx.textAlign;
    var k = KZ_ink(ctx, zone, text, fs);
    ctx.font = prevF; ctx.textBaseline = prevB; ctx.textAlign = prevA;
    return (k.asc - k.desc) / 2;
  }

  // ── v5 : une zone OVALE ou RONDE n'est pas un rectangle rapetissé ───
  // Avant : pour une zone ovale on rabotait la boîte de 29 % EN LARGEUR ET
  // EN HAUTEUR (x 0,707). C'est le carré inscrit dans l'ellipse : exact
  // uniquement si le bloc de texte est lui-même carré. Pour une ligne large
  // et basse — « Kevin et Melody » — la hauteur n'était pas le frein, mais on
  // bridait quand même la largeur de 29 % : la police restait trop petite.
  // Le vrai test : un bloc centre w x h tient dans une ellipse W x H si
  //     (w/W)^2 + (h/H)^2 <= 1
  // Bloc carre : resultat identique a avant. Bloc plat ou etroit : jusqu'a
  // +41 % de police. Ce test ne rend JAMAIS moins de place qu'avant.
  // Rectangle : test inchange au pixel pres.
  function KZ_fits(shape, W, H, w, h) {
    if (W <= 0 || H <= 0) return false;
    if (shape !== 'oval' && shape !== 'circle') return (w <= W && h <= H);
    var u = w / W, v = h / H;
    return (u * u + v * v) <= 1;
  }

  function KZ_fontSize(ctx, zone, text, boxW, boxH) {
    var shape = zone.shape || 'rectangle';
    var cap   = Math.max(KZ_FS_MIN, zone.font_size || 48);
    var lines = String(text == null ? '' : text).split('\n');
    if (!lines.some(function (l) { return l.trim(); })) return cap;

    var prevBaseline = ctx.textBaseline, prevAlign = ctx.textAlign, prevFont = ctx.font;
    var lo = KZ_FS_MIN, hi = cap, best = KZ_FS_MIN;
    while (lo <= hi) {
      var mid = (lo + hi) >> 1;
      var k   = KZ_ink(ctx, zone, text, mid);
      if (KZ_fits(shape, boxW, boxH, k.w + KZ_INK_SW, k.h + KZ_INK_SW)) { best = mid; lo = mid + 1; }
      else hi = mid - 1;
    }
    ctx.textBaseline = prevBaseline; ctx.textAlign = prevAlign; ctx.font = prevFont;
    return best;
  }

