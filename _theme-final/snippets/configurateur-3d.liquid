  window._kuztomPhotoDataUrls = window._kuztomPhotoDataUrls || {};

  function uploadPhotoSource(zoneId, dataUrl, label) {
    return new Promise(function(resolve) {
      try {
        var b64 = dataUrl.split(',')[1];
        if (!b64) { resolve(null); return; }
        var REPO = 'clcreation542-coder/Code-3D';
        // ── Nom triable : compte à rebours depuis une date lointaine dans le futur,
        // + mot d'origine "3d" pour identifier ce configurateur, + nom du design conservé.
        var FAR_FUTURE = 9999999999; // borne au-delà de l'année 2286, largement suffisant
        var nowSeconds = Math.floor(Date.now() / 1000);
        var inverted = String(FAR_FUTURE - nowSeconds).padStart(10, '0');
        var slug = (currentDesignName || 'design').toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 40);
        var filename = 'orders/' + inverted + '-3d-' + slug + '-photo-source-' + zoneId + '.png';
      fetch(PROXY_URL + '/file', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Auth-Key': PROXY_KEY },
        body: JSON.stringify({ path: filename, content: b64, message: 'photo source: ' + filename })
      }).then(function(res) {
        if (res.ok) { res.json().then(function (j) { resolve(j && j.url ? { url: j.url, label: label } : null); }).catch(function () { resolve(null); }); }   // lien réel renvoyé par le proxy (/view?key=…)
        else { resolve(null); }
        }).catch(function() { resolve(null); });
      } catch (e) { resolve(null); }
    });
  }

  function uploadAllPhotoSources() {
    var keys = Object.keys(window._kuztomPhotoDataUrls || {});
    if (keys.length === 0) return Promise.resolve([]);
    var promises = keys.map(function(zoneId) {
      var entry = window._kuztomPhotoDataUrls[zoneId];
      return uploadPhotoSource(zoneId, entry.dataUrl, entry.label);
    });
    return Promise.all(promises);
  }

  function updateLineItemProperties() {
    var form = document.querySelector('form[action*="/cart/add"]');
    if (!form || !fieldsContainer) return;
    form.querySelectorAll('input[data-kuztom]').forEach(function(el) { el.remove(); });
    injectProp(form, '_Design', currentDesignName || '');
    var colorLabel = fieldsContainer.querySelector('.kuztom-color-label');
    injectProp(form, 'Couleur gobelet', colorLabel ? colorLabel.textContent : '');
    var dateEl = document.getElementById('kuztom-event-date');
    if (dateEl && dateEl.value) injectProp(form, 'Date evenement', dateEl.value);
    Object.keys(window._kuztomPhotoFileNames || {}).forEach(function(zoneId) {
      var entry = window._kuztomPhotoFileNames[zoneId];
      if (!entry || !entry.name) return;
      injectProp(form, entry.label, entry.name);
    });
    fieldsContainer.querySelectorAll('.kuztom-textarea[data-zone-id]').forEach(function(ta) {
      var zoneId = ta.dataset.zoneId;
      var label = (ta.closest('.kuztom-field-group').querySelector('.kuztom-label') || {}).textContent || zoneId;
      var val = ta.value.trim();
      var info = zoneInfoCache[zoneId];
      if (val) {
        injectProp(form, label, val);
        var valBackoffice = val.replace(/ /g, '\u241B').replace(/\n/g, ' \u21B5\n');
        injectProp(form, '_' + label + ' backoffice', valBackoffice);
        injectProp(form, '_' + label + ' lignes', String(val.split('\n').length));
        if (info) injectProp(form, '_' + label + ' police', String(info.fontSize) + 'px');
      }
    });
    fieldsContainer.querySelectorAll('.kuztom-textarea[data-arch-zone-id]').forEach(function(ta) {
      var label = (ta.closest('.kuztom-field-group').querySelector('.kuztom-label') || {}).textContent || ta.dataset.archZoneId;
      var val = ta.value.trim();
      if (val) {
        injectProp(form, label, val);
        injectProp(form, '_' + label + ' backoffice', val.replace(/\n/g, ' \u21B5\n'));
      }
    });
  }

  function syncAll() {
