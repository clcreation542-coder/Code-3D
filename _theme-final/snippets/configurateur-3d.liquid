    if (!design || design.active === false) return;
    if (iframeWrap) {
      var iframeW = iframeWrap.offsetWidth || window.innerWidth * 0.5;
      iframe.setAttribute('width', iframeW); iframe.setAttribute('height', iframeW);
    }
    // Le viewer lit designs/<handle>.json directement (P6-01) ; proxy de test.
    var src = VIEWER_BASE + '?design=' + encodeURIComponent(design.shopify_handle || design.id)
            + '&proxy=' + encodeURIComponent(PROXY_URL);
    iframe.src = src;
    // P6-11 : la vignette flottante mobile passe &mini=1 (pas de loupe),
    // comme la verrerie.
    _kzMiniSrc=src+'&mini=1';
    buildForm(design);
  });

  (function() {
    function interceptCartButton() {
      var form = document.querySelector('form[action*="/cart/add"]');
      if (!form) { setTimeout(interceptCartButton, 500); return; }
      form.addEventListener('submit', function(e) {
        if (window._kuztomOrderDone) return;                 // seul submit natif autorisé : celui déclenché après réception du PNG
        e.preventDefault(); e.stopPropagation();             // tout autre submit est bloqué : jamais de commande sans PNG
        if (window._kuztomPendingSubmit) return;             // un flux est déjà en cours
        if (window._kuztomPngRequested) return;              // un essai est déjà lancé ; « Réessayer » réarme ce verrou
        var ok = verifierConditions();
        if (!ok) {
          var errEl = document.getElementById('kuztom-bloc-error');
          if (errEl) errEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        window._kuztomPendingSubmit = true;
        window._kuztomPngRequested = true;
        window._kzPhotoSrcDemandee = false;   // P6-10 : nouvelle tentative, nouvelle demande
        window._kzPhotoSrcAttente = false;
        var loadOv   = document.getElementById('kuztom-loading-overlay');
        var loadBar  = document.getElementById('kuztom-loading-bar');
        var loadText = document.getElementById('kuztom-loading-text');
        var pctEl    = document.getElementById('kuztom-loading-pct');
        if (loadOv) loadOv.classList.add('kuztom-loading-active');
        window._kuztomLoadInterval = startLoadingAnimation(loadBar, loadText, pctEl);

        // ── Boucle de réessai : redemande le PNG au GRAND iframe uniquement,
        //    toutes les 8 s, tant que le viewer n'est pas prêt / que le PNG
        //    n'est pas revenu. S'arrête dès réception de PRINT_PNG_READY.
        function requestPng() {
          if (!window._kuztomPendingSubmit) return;   // déjà résolu → on n'envoie plus rien
          if (!viewerReady) return;                   // viewer pas encore prêt → on retentera au prochain tick
          if (iframe && iframe.contentWindow) {
            iframe.contentWindow.postMessage({ type: 'REQUEST_PRINT_PNG', proxyUrl: PROXY_URL, proxyKey: PROXY_KEY, origin: '3d' }, VIEWER_ORIGIN);
            kzDemandePhotosSources();                   // P6-10 (une seule fois par tentative)
          }
        }
        requestPng();                                          // tentative immédiate (t=0)
        window._kuztomRetryInterval = setInterval(requestPng, 8000);

        // ── Fin de fenêtre : au bout de 60 s sans PNG → message d'erreur + blocage.
        window._kuztomTimeout = setTimeout(function() {
          if (window._kuztomPendingSubmit) {
            window._kuztomPendingSubmit = false;
            clearInterval(window._kuztomLoadInterval);
            clearInterval(window._kuztomRetryInterval);
            window._kzPhotoSrcAttente = false;
            if (loadOv) loadOv.classList.remove('kuztom-loading-active');
            showError();
          }
        }, 60000);
      }, true);
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', interceptCartButton); }
    else { setTimeout(interceptCartButton, 600); }
  })();

})();
</script>

<!-- Popup recapitulatif -->
<div id="kzp-overlay" role="dialog" aria-modal="true" aria-label="Recapitulatif de votre commande">
  <div id="kzp-modal">
    <div id="kzp-drag-handle"></div>
    <div id="kzp-top">
      {%- if product.featured_image -%}
      <div id="kzp-img-col">
        <img id="kzp-product-img" src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title | escape }}" width="300" height="300" loading="lazy">
      </div>
      {%- endif -%}
      <div id="kzp-title-col">
        <p id="kzp-brand">Kuztom</p>
        <h2 id="kzp-title">Recapitulatif</h2>
        <p id="kzp-subtitle">Verifiez avant de confirmer</p>
      </div>
    </div>
    <div id="kzp-sections">
      <div class="kzp-section">
        <div class="kzp-section-title">Votre produit</div>
        <div id="kzp-prod-rows"></div>
      </div>
      <div class="kzp-section" id="kzp-perso-section">
        <div class="kzp-section-title">Votre personnalisation</div>
        <div id="kzp-perso-rows"></div>
      </div>
