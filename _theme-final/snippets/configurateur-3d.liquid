    }
    return false;
  }

  function verifierConditions() {
    if (!fieldsContainer) return true;
    var contenance = getContenanceAffichee();
    var quantite   = getQuantiteAffichee();
    var restreinte = contenance ? estContenanceRestreinte(contenance) : false;
    var errorEl    = document.getElementById('kuztom-bloc-error');

    var swatchBlanc = fieldsContainer.querySelector('.kuztom-swatch[data-color="#ffffff"], .kuztom-swatch[data-color="#FFFFFF"]');
    if (swatchBlanc) {
      if (restreinte) {
        swatchBlanc.classList.add('kuztom-swatch-disabled');
        if (swatchBlanc.classList.contains('active')) {
          swatchBlanc.classList.remove('active');
          var premierDispo = fieldsContainer.querySelector('.kuztom-swatch:not(.kuztom-swatch-disabled)');
          if (premierDispo) {
            premierDispo.classList.add('active');
            var colorLabel = fieldsContainer.querySelector('.kuztom-color-label');
            if (colorLabel) colorLabel.textContent = premierDispo.dataset.colorName || 'Translucide';
            post({ type: 'UPDATE_COLOR', value: premierDispo.dataset.color, opacity: parseFloat(premierDispo.dataset.opacity || '0.88'), textColorOverride: null });
            updateLineItemProperties();
          }
        }
      } else {
        swatchBlanc.classList.remove('kuztom-swatch-disabled');
      }
    }

    var erreurs = [];
    var activeSwatch = fieldsContainer.querySelector('.kuztom-swatch.active');
    var couleurActive = activeSwatch ? (activeSwatch.dataset.color || '').toLowerCase() : '';

    if (restreinte && couleurActive === '#ffffff') {
      erreurs.push('Le gobelet Blanc n\u2019est pas disponible en ' + contenance + '. Veuillez choisir Translucide.');
    }
    if (restreinte && quantite > 0 && quantite < QTE_MIN) {
      erreurs.push('Le ' + contenance + ' est disponible \u00e0 partir de ' + QTE_MIN + ' gobelets minimum.');
    }

    if (errorEl) {
      if (erreurs.length > 0) {
        errorEl.className = 'kuztom-alert visible';
        errorEl.innerHTML = erreurs.join('<br>');
      } else {
        errorEl.className = '';
        errorEl.id = 'kuztom-bloc-error';
        errorEl.innerHTML = '';
      }
    }

    return erreurs.length === 0;
  }

  function watchContenance() {
    var variantPicker = document.querySelector('variant-picker');
    if (!variantPicker) { setTimeout(watchContenance, 500); return; }
    var observer = new MutationObserver(function() { setTimeout(verifierConditions, 400); });
    observer.observe(variantPicker, { subtree: true, childList: true, characterData: true });
    variantPicker.addEventListener('change', function() { setTimeout(verifierConditions, 400); });
    variantPicker.addEventListener('click', function() { setTimeout(verifierConditions, 600); });
    setTimeout(verifierConditions, 1000);
  }

  // ════════════════════════════════════════════════════════════
  //  CACHE : servir vite, mais ne JAMAIS servir périmé.
  //
  //  AVANT : si le cache avait moins d'1 h, on ne vérifiait RIEN. Conséquence :
  //  un design publié restait invisible jusqu'à 1 h pour tout visiteur déjà
  //  venu, un design retiré restait commandable, et Ctrl+Shift+R n'y changeait
  //  rien (le localStorage survit au rechargement forcé).
  //
  //  MAINTENANT : on sert le cache immédiatement (page instantanée) PUIS on
  //  revalide en arrière-plan. Si LE design de cette page a changé, on
  //  recharge une fois. Sinon on ne touche à rien.
  // ════════════════════════════════════════════════════════════
  var RELOAD_FLAG = 'kuztom_cache_reloaded';

  // ════════════════════════════════════════════════════════════
  //  P6-12 — UN SEUL chargement des données du design, partagé.
  //  On lit designs/<handle>.json (quelques Ko) au lieu de la liste
  //  complète designs-light.json (~600 Ko). Si ce fichier manque
  //  (fiche sans design, déploiement partiel…), on retombe sur la liste
  //  complète : au pire on refait exactement l'appel d'avant.
  //  Le design trouvé (ou null) est publié dans window.kzDesignPret
  //  (Promise) : kz-couleurs s'en sert au lieu de retélécharger.
  //  Le cache garde le même principe (servir tout de suite, revalider en
  //  arrière-plan, recharger une fois si CE design a changé), mais ne
  //  stocke plus que le design de la fiche.
  // ════════════════════════════════════════════════════════════
  var _kzResoutDesign = null;
  window.kzDesignPret = new Promise(function (r) { _kzResoutDesign = r; });
  window.kzDesignPret.kzHandle = productHandle;
  function kzPublieDesign(d) {
    if (_kzResoutDesign) { _kzResoutDesign(d || null); _kzResoutDesign = null; }
  }

  function kzFindDesign(list, handle) {
    if (!Array.isArray(list)) return null;
    for (var i = 0; i < list.length; i++) {
      if (list[i].shopify_handle && list[i].shopify_handle === handle) return list[i];
    }
    for (var j = 0; j < list.length; j++) {
      if (list[j].id && list[j].id.indexOf(handle) === 0) return list[j];
    }
    return null;
  }

  function loadDesigns(callback) {
    var served = false, cachedData = null;
    try {
      var cached = localStorage.getItem(CACHE_KEY);
      if (cached) {
        var parsed = JSON.parse(cached);
        if (parsed && parsed.ts && parsed.data && (Date.now() - parsed.ts) < CACHE_TTL) {
          cachedData = parsed.data;
          callback(cachedData);   // page instantanée
          served = true;
        }
      }
    } catch(e) {}

    // Revalidation : TOUJOURS, même si le cache est tout frais.
    kzTelechargeDesign()
      .then(function(design) {
        try { localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), data: design })); } catch(e) {}
        if (!served) { callback(design); return; }

        var avant = JSON.stringify(cachedData);
        var apres = JSON.stringify(design);
        if (avant === apres) {
          try { sessionStorage.removeItem(RELOAD_FLAG); } catch(e) {}
          return;                                   // rien de neuf
        }
        // Ne JAMAIS recharger sous les doigts d'un client en train de commander :
        // il perdrait sa photo et son panier en cours.
        if (window._kuztomPendingSubmit || window._kuztomPngRequested) return;
        if (Object.keys(window._kuztomPhotoDataUrls || {}).length) return;
        try {
          if (sessionStorage.getItem(RELOAD_FLAG)) return;   // sécurité anti-boucle
          sessionStorage.setItem(RELOAD_FLAG, '1');
        } catch(e) { return; }
        console.info('Kuztom: catalogue mis à jour → rechargement.');
        location.reload();
      })
      .catch(function(e) {
        // Réseau KO : si le cache a déjà servi, on continue avec. Sinon rien à afficher.
        console.warn('Kuztom: revalidation impossible:', e);
        if (!served) kzPublieDesign(null);
      });
  }

  // P6-12 : designs/<handle>.json d'abord, liste complète en repli.
  function kzTelechargeDesign() {
    return fetch(DESIGNS_BASE + encodeURIComponent(productHandle) + '.json', { cache: 'no-store' })
      .then(function(r) { return r.ok ? r.json() : Promise.reject('HTTP ' + r.status); })
      .then(function(d) {
        if (!d || Array.isArray(d) || typeof d !== 'object' || d.shopify_handle !== productHandle) throw new Error('Format inattendu');
        return d;
      })
      .catch(function() {
        return fetch(DESIGNS_URL, { cache: 'no-store' })
          .then(function(r) { return r.ok ? r.json() : Promise.reject('HTTP ' + r.status); })
          .then(function(designs) {
            if (!Array.isArray(designs)) throw new Error('Format inattendu');
            return kzFindDesign(designs, productHandle);
          });
      });
  }

  function sizeViewer() {
