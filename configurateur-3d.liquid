{% comment %}
  Kuztom — Configurateur 3D
  Gauche/haut : iframe viewer 3D
  Droite/bas  : nom shop, titre produit, zones texte, zones photo, couleurs
{% endcomment %}

{%- liquid
  assign design_handle = section.settings.design_handle | strip
  if design_handle == blank
    assign design_handle = product.handle
  endif
  assign viewer_height = section.settings.viewer_height | default: 560
  assign viewer_url    = 'https://clcreation542-coder.github.io/Code-3D/configurateur-viewer.html?design=' | append: design_handle
  assign couleur_blocks = section.blocks | where: 'type', 'couleur'
-%}

<div id="kz-root" data-design="{{ design_handle }}">
  <div class="kz-layout">

    <div class="kz-left" style="--kz-h:{{ viewer_height }}px;">
      <div class="kz-iframe-wrap">
        <iframe
          id="kz-iframe"
          src="{{ viewer_url }}"
          title="Aperçu 3D"
          style="width:100%;height:100%;border:none;display:block;position:relative;z-index:1;"
        ></iframe>
      </div>
      <p class="kz-hint">Explorer &agrave; 360&deg; &rarr;</p>
    </div>

    <div class="kz-right">

      <div class="kz-header">
        <p class="kz-shop">{{ shop.name }}</p>
        <h1 class="kz-title">{{ product.title }}</h1>
      </div>

      {%- for block in section.blocks -%}

        {%- if block.type == 'zone_texte' -%}
          <div class="kz-group" {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}
              <label class="kz-label" for="kz-ta-{{ block.id }}">
                {{- block.settings.label -}}
              </label>
            {%- endif -%}
            <textarea
              id="kz-ta-{{ block.id }}"
              class="kz-textarea"
              data-zone-id="{{ block.settings.zone_id }}"
              rows="3"
            ></textarea>
          </div>
        {%- endif -%}

        {%- if block.type == 'zone_photo' -%}
          <div class="kz-group" {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}
              <p class="kz-label">{{- block.settings.label -}}</p>
            {%- endif -%}
            <label class="kz-upload" for="kz-ph-{{ block.id }}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="16 16 12 12 8 16"></polyline>
                <line x1="12" y1="12" x2="12" y2="21"></line>
                <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"></path>
              </svg>
              <span class="kz-upload-text">Choisir une photo</span>
              <input
                type="file"
                id="kz-ph-{{ block.id }}"
                class="kz-file"
                data-zone-id="{{ block.settings.zone_id }}"
                accept="image/*"
              >
            </label>
          </div>
        {%- endif -%}

        {%- if block.type == 'couleur' -%}
          {%- assign hex = block.settings.couleur_hex | strip -%}
          {%- if hex != blank -%}
            {%- unless forloop.first == false and forloop.index0 > 0 -%}{%- endunless -%}
            <button
              type="button"
              class="kz-swatch"
              data-color="{{ hex }}"
              style="background:{{ hex }};"
              aria-label="{%- if block.settings.label != blank -%}{{ block.settings.label }}{%- else -%}{{ hex }}{%- endif -%}"
              {{ block.shopify_attributes }}
            ></button>
          {%- endif -%}
        {%- endif -%}

      {%- endfor -%}

    </div>
  </div>
</div>

{{- '<!-- Mini viewer mobile (visible uniquement sous 767px quand le grand viewer est hors écran) -->' }}
<div id="kz-mini-viewer" aria-hidden="true">
  <iframe
    src="{{ viewer_url }}"
    title="Aperçu miniature"
    tabindex="-1"
    style="width:144px;height:144px;border:none;display:block;transform:scale(0.5);transform-origin:top left;pointer-events:none;"
  ></iframe>
</div>

{%- if couleur_blocks.size > 0 -%}
<script>
// Regroup swatches into a wrapper injected before first swatch
(function () {
  var root = document.getElementById('kz-root');
  if (!root) return;
  var swatches = root.querySelectorAll('.kz-swatch');
  if (!swatches.length) return;
  var wrapper = document.createElement('div');
  wrapper.className = 'kz-swatches-wrap';
  swatches[0].parentNode.insertBefore(wrapper, swatches[0]);
  swatches.forEach(function (s) { wrapper.appendChild(s); });
})();
</script>
{%- endif -%}

<style>
  #kz-root {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    font-family: inherit;
  }

  .kz-layout {
    display: flex;
    flex-direction: row;
    width: 100%;
  }

  /* ── Gauche : viewer ───────────────────────────────────── */

  .kz-left {
    flex: 0 0 50%;
    width: 50%;
    display: flex;
    flex-direction: column;
  }

  .kz-iframe-wrap {
    flex: 1;
    min-height: var(--kz-h, 560px);
    position: relative;
    border-radius: 16px;
    background: #faf8f5;
    overflow: hidden;
  }

  /* Angle de mur en arrière-plan — deux plans en perspective légère */
  .kz-iframe-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(135deg,
        #e8e3dc 0%,
        #e8e3dc 48%,
        #ede9e3 48.5%,
        #ede9e3 100%
      );
    border-radius: 16px;
  }

  .kz-hint {
    text-align: center;
    font-size: 13px;
    color: #b8a898;
    letter-spacing: 0.06em;
    padding: 11px 0 13px;
    margin: 0;
    border-top: 1px solid #ede9e3;
  }

  .kz-hint::before {
    content: '↻\00a0';
  }

  /* ── Droite : champs ───────────────────────────────────── */

  .kz-right {
    flex: 0 0 50%;
    width: 50%;
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    overflow-y: auto;
    box-sizing: border-box;
  }

  .kz-header { display: flex; flex-direction: column; gap: 5px; }

  .kz-shop {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #aaa;
    margin: 0;
  }

  .kz-title {
    font-size: 22px;
    font-weight: 700;
    color: #1c1c1c;
    margin: 0;
    line-height: 1.25;
  }

  /* ── Groupe champ ──────────────────────────────────────── */

  .kz-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .kz-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #1c1c1c;
    margin: 0;
  }

  /* ── Textarea ──────────────────────────────────────────── */

  .kz-textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid #e0dbd4;
    border-radius: 10px;
    font-size: 15px;
    font-family: inherit;
    color: #1c1c1c;
    background: #fdfcfb;
    outline: none;
    resize: vertical;
    min-height: 80px;
    line-height: 1.55;
    transition: border-color 120ms;
    box-sizing: border-box;
    white-space: pre-wrap;
  }

  .kz-textarea:focus { border-color: #c9a96e; }

  /* ── Upload photo ──────────────────────────────────────── */

  .kz-upload {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1.5px dashed #c4bfb9;
    border-radius: 5px;
    cursor: pointer;
    font-size: 14px;
    color: #555;
    background: #fafaf8;
    transition: border-color 120ms, background 120ms;
    user-select: none;
    width: fit-content;
  }

  .kz-upload:hover {
    border-color: #c9a96e;
    background: #fffdf8;
  }

  .kz-file {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* ── Swatches couleur ──────────────────────────────────── */

  .kz-swatches-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .kz-swatch {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    padding: 0;
    outline: none;
    box-shadow: 0 1px 4px rgba(0,0,0,0.20);
    transition: transform 120ms, border-color 120ms;
    flex-shrink: 0;
  }

  .kz-swatch:hover  { transform: scale(1.15); }
  .kz-swatch.active { border-color: #1c1c1c; }

  /* ── Mini viewer mobile ────────────────────────────────── */

  #kz-mini-viewer {
    display: none;
    position: fixed;
    top: 12px;
    right: 12px;
    z-index: 999;
    width: 72px;
    height: 72px;
    border-radius: 12px;
    border: 2px solid #c9a96e;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.15);
    cursor: pointer;
    background: #faf8f5;
  }

  @media (max-width: 767px) {
    #kz-mini-viewer.kz-mini-visible {
      display: block;
    }
  }

  /* ── Mobile ────────────────────────────────────────────── */

  @media (max-width: 767px) {
    .kz-layout { flex-direction: column; }

    .kz-left  { flex: none; width: 100%; }
    .kz-right { flex: none; width: 100%; padding: 24px 16px; }

    .kz-iframe-wrap { min-height: 280px; }
  }
</style>

<script>
(function () {
  var VIEWER_ORIGIN = 'https://clcreation542-coder.github.io';
  var REPO_BASE     = 'https://clcreation542-coder.github.io/Code-3D';
  var root          = document.getElementById('kz-root');
  var iframe        = document.getElementById('kz-iframe');
  if (!root || !iframe) return;

  var designHandle = root.dataset.design || '';
  var viewerReady  = false;
  var pendingSync  = false;

  /* ── postMessage helper ─────────────────────────────── */
  function post(data) {
    if (iframe.contentWindow) {
      iframe.contentWindow.postMessage(data, VIEWER_ORIGIN);
    }
  }

  /* ── Envoyer toutes les valeurs courantes au viewer ─── */
  function syncAll() {
    root.querySelectorAll('.kz-textarea[data-zone-id]').forEach(function (ta) {
      post({ type: 'kuztom_update', zoneId: ta.dataset.zoneId, value: ta.value });
    });
    var active = root.querySelector('.kz-swatch.active');
    if (active) {
      post({ type: 'kuztom_color', color: active.dataset.color });
    }
  }

  /* ── Quand le viewer signale qu'il est prêt ─────────── */
  window.addEventListener('message', function (e) {
    if (!e.data || e.data.type !== 'kuztom_ready') return;
    viewerReady = true;
    if (pendingSync) { syncAll(); pendingSync = false; }
  });

  /* ── Charger le JSON du design pour valeurs par défaut ─ */
  if (designHandle) {
    fetch(REPO_BASE + '/designs/' + encodeURIComponent(designHandle) + '.json')
      .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
      .then(function (cfg) {
        var zones = (cfg && Array.isArray(cfg.text_zones)) ? cfg.text_zones : [];
        zones.forEach(function (zone) {
          if (!zone.id || !zone.placeholder) return;
          var ta = root.querySelector('.kz-textarea[data-zone-id="' + zone.id + '"]');
          if (ta && ta.value === '') {
            /* Respecte les \n — textarea.value les préserve nativement */
            ta.value = zone.placeholder;
          }
        });
        if (viewerReady) {
          syncAll();
        } else {
          pendingSync = true;
        }
      })
      .catch(function () {
        if (viewerReady) { syncAll(); } else { pendingSync = true; }
      });
  }

  /* ── Textareas : postMessage à chaque frappe ─────────── */
  root.querySelectorAll('.kz-textarea[data-zone-id]').forEach(function (ta) {
    ta.addEventListener('input', function () {
      post({ type: 'kuztom_update', zoneId: ta.dataset.zoneId, value: ta.value });
    });
  });

  /* ── Swatches couleur ───────────────────────────────── */
  root.querySelectorAll('.kz-swatch').forEach(function (btn) {
    btn.addEventListener('click', function () {
      root.querySelectorAll('.kz-swatch').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      post({ type: 'kuztom_color', color: btn.dataset.color });
    });
  });

  /* Premier swatch actif par défaut */
  var first = root.querySelector('.kz-swatch');
  if (first) first.classList.add('active');

  /* ── Photos : lire en base64 puis postMessage ─────────── */
  root.querySelectorAll('.kz-file[data-zone-id]').forEach(function (input) {
    input.addEventListener('change', function () {
      var file = input.files && input.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function (ev) {
        post({ type: 'kuztom_photo', zoneId: input.dataset.zoneId, dataUrl: ev.target.result });
        var span = input.closest('.kz-upload') && input.closest('.kz-upload').querySelector('.kz-upload-text');
        if (span) span.textContent = file.name;
      };
      reader.readAsDataURL(file);
    });
  });

})();
</script>

<script>
/* ── Mini viewer mobile — IntersectionObserver ─────────── */
(function () {
  var mini    = document.getElementById('kz-mini-viewer');
  var mainWrap = document.querySelector('#kz-root .kz-iframe-wrap');
  if (!mini || !mainWrap || !window.IntersectionObserver) return;

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        mini.classList.remove('kz-mini-visible');
      } else {
        mini.classList.add('kz-mini-visible');
      }
    });
  }, { threshold: 0.1 });

  observer.observe(mainWrap);

  mini.addEventListener('click', function () {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
})();
</script>

{% schema %}
{
  "name": "Configurateur 3D",
  "tag": "section",
  "class": "kuztom-3d-section",
  "settings": [
    {
      "type": "text",
      "id": "design_handle",
      "label": "Handle du design (laisser vide = handle produit Shopify)",
      "info": "Correspond au fichier designs/<handle>.json sur GitHub Pages",
      "default": ""
    },
    {
      "type": "range",
      "id": "viewer_height",
      "label": "Hauteur du viewer (px)",
      "min": 300,
      "max": 800,
      "step": 20,
      "default": 560
    }
  ],
  "blocks": [
    {
      "type": "zone_texte",
      "name": "Zone de texte",
      "settings": [
        {
          "type": "text",
          "id": "zone_id",
          "label": "ID de la zone (doit correspondre à l'ID dans le JSON design)",
          "default": "zone_1"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label affiché au client",
          "default": "Votre texte"
        }
      ]
    },
    {
      "type": "zone_photo",
      "name": "Zone photo",
      "settings": [
        {
          "type": "text",
          "id": "zone_id",
          "label": "ID de la zone (doit correspondre à l'ID dans le JSON design)",
          "default": "photo_1"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label affiché au client",
          "default": "Votre photo"
        }
      ]
    },
    {
      "type": "couleur",
      "name": "Couleur",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Nom de la couleur (optionnel)",
          "default": ""
        },
        {
          "type": "text",
          "id": "couleur_hex",
          "label": "Couleur HEX",
          "default": "#f5f0eb"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Configurateur 3D"
    }
  ]
}
{% endschema %}
