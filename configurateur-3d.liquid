{% comment %}
  Kuztom — Section configurateur 3D
  Contenu : iframe viewer + champs texte + couleurs uniquement
{% endcomment %}

{%- liquid
  assign design_name = section.settings.design_name | strip
  assign viewer_base = 'https://clcreation542-coder.github.io/Code-3D/configurateur-viewer.html'
  assign viewer_url  = viewer_base | append: '?design=' | append: design_name
-%}

<div
  id="kuztom-configurateur"
  data-section-id="{{ section.id }}"
  style="width:100%;max-width:1200px;margin:0 auto;"
>
  <div class="kuztom-layout">

    <div class="kuztom-viewer">
      <iframe
        id="kuztom-iframe"
        src="{{ viewer_url }}"
        allow="cross-origin-isolated"
        loading="lazy"
        style="width:100%;height:100%;border:none;display:block;"
      ></iframe>
    </div>

    <div class="kuztom-fields">

      {%- assign color_blocks = section.blocks | where: 'type', 'color_swatch' -%}
      {%- if color_blocks.size > 0 -%}
        <div class="kuztom-group">
          {%- for block in color_blocks -%}
            <div class="kuztom-swatches" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}
                <p class="kuztom-label">{{ block.settings.label }}</p>
              {%- endif -%}
              <div class="kuztom-swatch-row">
                {%- assign colors = block.settings.colors | split: ',' -%}
                {%- assign opacities = block.settings.opacities | split: ',' -%}
                {%- for color in colors -%}
                  {%- assign hex = color | strip -%}
                  {%- assign op_raw = opacities[forloop.index0] | strip -%}
                  {%- assign op = op_raw | default: '0.88' -%}
                  <button
                    type="button"
                    class="kuztom-swatch"
                    data-hex="{{ hex }}"
                    data-opacity="{{ op }}"
                    style="background:{{ hex }};"
                    aria-label="{{ hex }}"
                  ></button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'text_zone' -%}
          <div class="kuztom-group" {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}
              <label class="kuztom-label" for="kuztom-field-{{ block.id }}">
                {{ block.settings.label }}
              </label>
            {%- endif -%}
            {%- if block.settings.multiline -%}
              <textarea
                id="kuztom-field-{{ block.id }}"
                class="kuztom-input"
                data-zone-id="{{ block.settings.zone_id }}"
                placeholder="{{ block.settings.placeholder | escape }}"
                rows="3"
              ></textarea>
            {%- else -%}
              <input
                type="text"
                id="kuztom-field-{{ block.id }}"
                class="kuztom-input"
                data-zone-id="{{ block.settings.zone_id }}"
                placeholder="{{ block.settings.placeholder | escape }}"
              >
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>
  </div>
</div>

<style>
  .kuztom-layout {
    display: flex;
    flex-direction: row;
    gap: 0;
    width: 100%;
    min-height: 520px;
  }

  .kuztom-viewer {
    flex: 0 0 50%;
    width: 50%;
    min-height: 400px;
    position: relative;
  }

  .kuztom-fields {
    flex: 0 0 50%;
    width: 50%;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    overflow-y: auto;
  }

  .kuztom-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .kuztom-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #2c2521;
    margin: 0;
  }

  .kuztom-input {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid #d8d4cf;
    border-radius: 6px;
    font-size: 15px;
    font-family: inherit;
    color: #2c2521;
    background: #fff;
    outline: none;
    transition: border-color 150ms ease;
    resize: vertical;
  }

  .kuztom-input:focus {
    border-color: #c9a96e;
  }

  .kuztom-swatch-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .kuztom-swatch {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: border-color 150ms ease, transform 150ms ease;
    padding: 0;
    outline: none;
  }

  .kuztom-swatch:hover  { transform: scale(1.12); }
  .kuztom-swatch.active { border-color: #2c2521; }

  @media (max-width: 767px) {
    .kuztom-layout {
      flex-direction: column;
      min-height: unset;
    }
    .kuztom-viewer {
      flex: none;
      width: 100%;
      min-height: 320px;
    }
    .kuztom-fields {
      flex: none;
      width: 100%;
      padding: 24px 16px;
    }
  }
</style>

<script>
(function () {
  const VIEWER_ORIGIN = 'https://clcreation542-coder.github.io';
  const iframe        = document.getElementById('kuztom-iframe');

  let activeHex     = null;
  let activeOpacity = 0.88;
  let viewerReady   = false;

  function postToViewer(data) {
    if (iframe && iframe.contentWindow) {
      iframe.contentWindow.postMessage(data, VIEWER_ORIGIN);
    }
  }

  function collectTexts() {
    const zones = [];
    document.querySelectorAll('#kuztom-configurateur .kuztom-input[data-zone-id]').forEach(function (el) {
      zones.push({ id: el.dataset.zoneId, text: el.value });
    });
    return zones;
  }

  function sendAllTexts() {
    const zones = collectTexts();
    if (zones.length) postToViewer({ type: 'kuztom_update', zones: zones });
  }

  function sendColor(hex, opacity) {
    postToViewer({ type: 'kuztom_color', hex: hex, opacity: parseFloat(opacity) });
  }

  function syncViewer() {
    if (activeHex) sendColor(activeHex, activeOpacity);
    sendAllTexts();
  }

  // Réception du signal kuztom_ready depuis l'iframe
  window.addEventListener('message', function (e) {
    if (e.data && e.data.type === 'kuztom_ready') {
      viewerReady = true;
      syncViewer();
    }
  });

  // Champs texte — mise à jour à chaque frappe
  document.querySelectorAll('#kuztom-configurateur .kuztom-input[data-zone-id]').forEach(function (el) {
    el.addEventListener('input', function () {
      postToViewer({ type: 'kuztom_update', zones: [{ id: el.dataset.zoneId, text: el.value }] });
    });
  });

  // Couleurs
  document.querySelectorAll('#kuztom-configurateur .kuztom-swatch').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('#kuztom-configurateur .kuztom-swatch').forEach(function (b) {
        b.classList.remove('active');
      });
      btn.classList.add('active');
      activeHex     = btn.dataset.hex;
      activeOpacity = btn.dataset.opacity || 0.88;
      sendColor(activeHex, activeOpacity);
    });
  });

  // Sélectionner la première couleur par défaut
  var firstSwatch = document.querySelector('#kuztom-configurateur .kuztom-swatch');
  if (firstSwatch) firstSwatch.click();

})();
</script>

{% schema %}
{
  "name": "Configurateur 3D",
  "tag": "section",
  "class": "kuztom-section",
  "settings": [
    {
      "type": "text",
      "id": "design_name",
      "label": "Nom du design",
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "text_zone",
      "name": "Zone de texte",
      "settings": [
        {
          "type": "text",
          "id": "zone_id",
          "label": "ID de zone",
          "default": "zone_1"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label du champ",
          "default": "Votre texte"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder",
          "default": ""
        },
        {
          "type": "checkbox",
          "id": "multiline",
          "label": "Multiligne",
          "default": false
        }
      ]
    },
    {
      "type": "color_swatch",
      "name": "Palette de couleurs",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Couleur du gobelet"
        },
        {
          "type": "text",
          "id": "colors",
          "label": "Couleurs HEX (séparées par des virgules)",
          "default": "#f5f0eb,#d4b896,#2c2521"
        },
        {
          "type": "text",
          "id": "opacities",
          "label": "Opacités (séparées par des virgules, ex: 0.88,0.88,0.88)",
          "default": "0.88,0.88,0.88"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Configurateur 3D"
    }
  ]
}
{% endschema %}
