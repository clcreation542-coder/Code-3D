    // ── PROMPT — anglais, textes client protégés, plein-largeur aéré, sécurité impression ──
function buildPrompt() {
      var pr=inpPrenom.value.trim(), ev=selEv.value, th=getTheme();
      if (!pr||!ev||!th) return null;
      var stKey=getStyle();
      S.iaFields={prenom:pr, evenement:ev, theme:th, style:stKey, faces:(selFaces.value==='deux'?'Deux faces (avant / arrière)':'Un seul décor tout autour'), verso:(selFaces.value==='deux'?inpVerso.value.trim():''), couleurs:inpCouleurs.value.trim(), dateGobelet:inpDate.value.trim(), ecriture:selEcriture.value, phrase:inpPhrase.value.trim(), eviter:inpEviter.value.trim()};
      var evFinal = ev === 'Autre' ? (autreInp.value.trim() || 'Autre') : ev;
      var detailTxt = inpDetail.value.trim();
      S.iaFields.detail = detailTxt;
      var estAnnivAge = (ev === 'Anniversaire enfant' || ev === 'Anniversaire adulte');
      var ligneEv;
      if (estAnnivAge) {
        // Anniversaire : jamais le mot « Anniversaire ». Chiffre seul -> « 1 an » / « 50 ans ».
        if (!detailTxt) ligneEv = '';
        else if (/^\d+$/.test(detailTxt)) ligneEv = detailTxt + (parseInt(detailTxt,10) === 1 ? ' an' : ' ans');
        else ligneEv = detailTxt;
      } else if (ev === 'Anniversaire de mariage') {
        ligneEv = selNoces.value || 'Anniversaire de mariage';
      } else if (ev === 'Retraite') {
        ligneEv = 'Retraite';   // le métier sert d'inspiration, il n'est pas imprimé
      } else if (ev === 'Diplôme / Réussite') {
        ligneEv = selDip.value || 'Diplôme';
      } else {
        // Autres événements : on évite toute répétition entre l'événement et le détail.
        var evNom = evFinal.split('/')[0].trim();
        if (!detailTxt) {
          ligneEv = evNom;
        } else {
          var kzNorm = function(t){
            return t.toLowerCase()
              .normalize('NFD').replace(/[̀-ͯ]/g,'')
              .replace(/[^a-z0-9 ]/g,' ').replace(/\s+/g,' ').trim();
          };
          var stop = [' de ',' du ',' des ',' la ',' le ',' les ',' et ',' d ',' l ',' un ',' une ',' pour ',' ans ',' an '];
          var evMots = (' '+kzNorm(evNom)+' ').split(' ').filter(function(m){
            return m && stop.indexOf(' '+m+' ') === -1;
          });
          var detNorm = ' '+kzNorm(detailTxt)+' ';
          var chevauche = evMots.some(function(m){ return detNorm.indexOf(' '+m+' ') !== -1; });
          // Si le détail reprend déjà un mot de l'événement, on n'imprime que le détail.
          ligneEv = chevauche ? detailTxt : (evNom + ' ' + detailTxt);
        }
      }

      // « de » / « d’ » selon le prénom (Baptême d’Allan, Mariage de Léa & Thomas)
      function kzDe(nom){
        var c = nom.trim().charAt(0).toLowerCase()
          .normalize('NFD').replace(/[̀-ͯ]/g,'');
        return ('aeiouyh'.indexOf(c) !== -1) ? 'd’' : 'de ';
      }
      var texteEv;
      if (estAnnivAge) {
        // Anniversaire : prénom et âge restent deux textes séparés.
        texteEv = '"'+pr+'"' + (ligneEv ? ' et "'+ligneEv+'"' : '');
      } else if (ev === 'Demande en mariage' || !ligneEv) {
        texteEv = '"'+pr+'"';
      } else {
        // Une seule phrase naturelle : « Baptême d’Allan », « Retraite de Martine »…
        texteEv = '"'+ligneEv+' '+kzDe(pr)+pr+'"';
      }
      var textes = texteEv
        + (inpDate.value.trim() ? ' et "'+inpDate.value.trim()+'"' : '')
        + (inpPhrase.value.trim() ? ' et "'+inpPhrase.value.trim()+'"' : '');

      /* ════════════════════════════════════════════════════════════
         LE TEXTE ENVOYÉ À L'IA — VERSION COURTE (14/09/2026)
         ------------------------------------------------------------
         POURQUOI IL A ÉTÉ RACCOURCI. La version précédente faisait sept
         consignes et plus de mille mots, accumulées correctif après
         correctif. Trois défauts, tous mesurés sur Gemini :
           · les modèles d'image retiennent surtout le DÉBUT et la FIN ;
             tout ce qu'on empile au milieu pèse peu ;
           · les phrases négatives (« aucun cadre », « pas de marge »)
             sont mal gérées par les modèles d'image et attirent parfois
             ce qu'elles interdisent ;
           · plus c'est long, plus les consignes se diluent et se
             contredisent.
         La version ci-dessous dit la même chose en ~350 mots, avec des
         formulations POSITIVES et une seule image mentale par idée.
         ⚠ AVANT D'AJOUTER UNE PHRASE ICI : en retirer une autre.
            Chaque correctif empilé nous a coûté de la précision.
         ════════════════════════════════════════════════════════════ */
      var lines=[];

      // 1 · LE SUJET — c'est ce que l'image EST, il passe en premier.
      lines.push('Crée une illustration 100 % originale, '+(STYLE_PROMPT[stKey]||STYLE_PROMPT['Aquarelle'])+', sur le thème : '+th+(inpCouleurs.value.trim() ? ' (couleurs : '+inpCouleurs.value.trim()+')' : '')+'. Rien de protégé par des droits : pas de personnage, logo, blason, mascotte, visage réel ni marque existants.');

      // 2 · LA COMPOSITION — fond, cadrage et débordement en une seule idée.
      lines.push('Image plate au format paysage 16:9, motif vu de face, sur fond blanc uni (ce blanc sera rendu transparent avant impression, il reste donc derrière et entre les éléments). Le décor occupe toute l’image : les feuilles, branches, formes et motifs sont tranchés par les quatre bords, comme si le dessin continuait au-delà.');

      // 3 · LES DEUX FACES, si le client les a demandées.
      if (selFaces.value === 'deux') {
        lines.push('Compose l’image en deux moitiés : la gauche est la face avant du gobelet, la droite la face arrière, dans le même style et la même palette. Au centre, la transition est dessinée avec les éléments du décor eux-mêmes — feuillage, guirlande, ruban, dégradé. Le décor se poursuit aussi du bord extrême gauche au bord extrême droit : ces deux bords se rejoignent une fois l’image enroulée autour du gobelet.');
      }

      // 4 · LES TEXTES — recopiés à l'identique, c'est le point sensible.
      if (selFaces.value === 'deux') {
        var verso = inpVerso.value.trim();
        lines.push('Sur la moitié gauche, écris en grand et bien lisible, exactement ainsi : '+textes+'.'
          + (verso ? ' Sur la moitié droite, écris de même : "'+verso+'", et rien d’autre.' : ' La moitié droite ne porte aucun texte.'));
      } else {
        lines.push('Écris en grand et bien lisible, exactement ainsi, sans rien modifier : '+textes+'.');
      }

      // 5 · LES PRÉCISIONS DU CLIENT — une seule ligne, seulement si elles existent.
      var extras=[];
      if (selEcriture.value) extras.push('écriture '+selEcriture.value.toLowerCase());
      var genreSel = getGenre();
      if (ev === 'Naissance' || ev === 'Baby shower') {
        if (genreSel === 'Fille') extras.push('couleurs douces pour une petite fille');
        else if (genreSel === 'Garçon') extras.push('couleurs douces pour un petit garçon');
        else if (genreSel === 'Surprise') extras.push('couleurs neutres et douces, le sexe du bébé est une surprise');
      }
      if (ev === 'Retraite' && detailTxt) extras.push('inspire-toi discrètement du métier de '+detailTxt+', sans écrire ce mot');
      if (inpEviter.value.trim()) extras.push('à éviter absolument : '+inpEviter.value.trim());
      if (extras.length) lines.push('Précisions : '+extras.join(' ; ')+'.');

      // 6 · LE RAPPEL FINAL — la fin porte autant que le début.
      lines.push('Rappel : illustration entièrement originale, sans aucun élément protégé, et décor tranché par les quatre bords. Génère directement l’image.');

      return lines.join('\n');
    }

    function handleAI(url) {
      var p=buildPrompt();
