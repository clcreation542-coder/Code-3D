    var selFaces=document.createElement('select'); selFaces.className='kzc-select';
    /* ⚠ LIBELLÉS COURTS OBLIGATOIRES. Un <select> ne va pas à la ligne :
       sur téléphone, « Un seul décor, tout autour du gobelet » était coupé
