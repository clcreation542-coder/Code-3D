<script>
document.addEventListener('DOMContentLoaded', function() {
var PROXY_URL = 'https://kuztom-proxy-test.contact-kuztom.workers.dev';
  var PROXY_KEY = '';
  var CONTACT_EMAIL = 'contact@kuztom.fr';
  var isMobile = window.innerWidth < 768;

  function genId() {
    var c='ABCDEFGHJKLMNPQRSTUVWXYZ23456789', id='kzt-';
    for(var i=0;i<6;i++) id+=c[Math.floor(Math.random()*c.length)];
    return id;
  }
  var SESSION_ID = genId();

  var S = { cImg:null, cName:null, vReady:false, eventDate:null, iaFields:{} };

  var iframe     = document.getElementById('kzc-iframe');
  var miniIframe = document.getElementById('kzc-mini-iframe');
  var miniViewer = document.getElementById('kzc-mini-viewer');
  var iframeWrap = document.getElementById('kzc-iframe-wrap');

  // Size viewer
  function sizeViewer() {
    if (!iframeWrap) return;
    var w = iframeWrap.offsetWidth || Math.round(window.innerWidth*0.5);
    iframeWrap.style.height = w + 'px';
  }
  sizeViewer();
  window.addEventListener('resize', sizeViewer);

  // ── SCROLL MOBILE FIX ──
  // Sur mobile, on détecte si le geste est vertical → on laisse scroller la page
  // Si horizontal → on laisse le viewer tourner le gobelet
  if (iframe) {
    var _touchStartX = 0, _touchStartY = 0, _scrollLocked = false;
    iframe.addEventListener('touchstart', function(e) {
      if (e.touches.length !== 1) return;
      _touchStartX = e.touches[0].clientX;
      _touchStartY = e.touches[0].clientY;
      _scrollLocked = false;
    }, { passive: true });
    iframe.addEventListener('touchmove', function(e) {
      if (e.touches.length !== 1) return;
      var dx = Math.abs(e.touches[0].clientX - _touchStartX);
      var dy = Math.abs(e.touches[0].clientY - _touchStartY);
      if (!_scrollLocked) {
        if (dy > dx + 5) {
          // Geste vertical → laisser scroller la page
          _scrollLocked = true;
          return;
        }
      }
      if (_scrollLocked) return;
    }, { passive: true });
  }

  // ── Le mini viewer ne se charge QUE s'il devient réellement visible (mobile).
  //    Avant : le 3D était téléchargé deux fois, même sur ordinateur où il est masqué.
  var _kzMiniLoaded = false;
  function kzLoadMini() {
    if (_kzMiniLoaded || !miniIframe) return;
    var src = miniIframe.getAttribute('data-src');
    if (!src) return;
    _kzMiniLoaded = true;
    miniIframe.src = src;
  }

  if (isMobile && iframeWrap && miniViewer) {
    window.addEventListener('scroll', function() {
      var r = iframeWrap.getBoundingClientRect();
      var visible = (r.bottom>0&&r.top<window.innerHeight);
      miniViewer.style.display = visible ? 'none' : 'block';
      if (!visible) kzLoadMini();
    }, {passive:true});
    miniViewer.addEventListener('click', function() {
      iframeWrap.scrollIntoView({behavior:'smooth',block:'start'});
    });
  }

  function postV(data) {
    if (iframe&&iframe.contentWindow) iframe.contentWindow.postMessage(data,'*');
    if (_kzMiniLoaded && miniIframe && miniIframe.contentWindow) miniIframe.contentWindow.postMessage(data,'*');
  }

  function injectProp(key, val) {
    var form = document.querySelector('form[action*="/cart/add"]'); if (!form) return;
    var el = form.querySelector('input[name="properties['+key+']"][data-kzc="1"]');
    if (!el) {
      el = document.createElement('input');
      el.type='hidden'; el.name='properties['+key+']'; el.setAttribute('data-kzc','1');
      form.appendChild(el);
    }
    el.value = val;
  }

  function updateProps() {
    injectProp('_Référence design', SESSION_ID);
    if (S.iaFields.prenom) injectProp('Prénom(s)', S.iaFields.prenom);
    if (S.iaFields.evenement) injectProp('Événement', S.iaFields.evenement);
    if (S.iaFields.theme) injectProp('Thème visuel', S.iaFields.theme);
    if (S.iaFields.style) injectProp('Style du dessin', S.iaFields.style);
    if (S.iaFields.dateGobelet) injectProp('Date sur le gobelet', S.iaFields.dateGobelet);
    if (S.iaFields.couleurs) injectProp('Couleurs souhaitées', S.iaFields.couleurs);
    if (S.iaFields.ecriture) injectProp('Style d’écriture', S.iaFields.ecriture);
    if (S.iaFields.phrase) injectProp('Phrase en plus', S.iaFields.phrase);
    if (S.iaFields.eviter) injectProp('À éviter', S.iaFields.eviter);
    if (S.eventDate) injectProp('Date événement', S.eventDate);
  }

  // ── Messages loading ──
  var LOADING_MESSAGES = [
    'Préparation de votre commande…',
    'Envoi du design à l\'imprimeur…',
    'Vérification des couleurs…',
    'Finalisation en cours…'
  ];

  function startLoadingAnimation(lb, ltxt) {
    var pct = 0;
    var msgIdx = 0;
    var tick = 0;
    if (ltxt) ltxt.textContent = LOADING_MESSAGES[0];
    var pctEl = document.getElementById('kzc-loading-pct');
    if (lb) lb.style.width = '0%';
    if (pctEl) pctEl.textContent = '0%';
    // Avance vite au début puis ralentit, mais bouge toujours (min 0,5/pas) : jamais de blocage.
    var interval = setInterval(function() {
      if (pct < 99) pct = Math.min(pct + Math.max((99 - pct) * 0.05, 0.5), 99);
      var shown = Math.round(pct);
      if (lb) lb.style.width = shown + '%';
      if (pctEl) pctEl.textContent = shown + '%';
      // Messages en boucle infinie toutes les ~3 s (15 ticks × 200ms), indépendants du %.
      tick++;
      if (tick % 15 === 0) {
        msgIdx = (msgIdx + 1) % LOADING_MESSAGES.length;
        if (ltxt) ltxt.textContent = LOADING_MESSAGES[msgIdx];
      }
    }, 200);
    return interval;
  }

  window.addEventListener('message', function(e) {
    if (!/^https:\/\/([a-z0-9-]+\.)?code-3d\.pages\.dev$/.test(e.origin || '') && e.origin !== 'https://clcreation542-coder.github.io') return;   // P2-08 : messages du viewer uniquement
    if (!e.data) return;
    if (e.data.type === 'kuztom_ready') {
      // Le mini viewer arrive plus tard : on lui renvoie l'état actuel, puis on s'arrête.
      if (_kzMiniLoaded && miniIframe && e.source === miniIframe.contentWindow) {
        miniIframe.classList.add('kzc-ready');
        var mw = miniIframe.contentWindow;
        mw.postMessage({type:'SET_AUTO_ROTATE', value:false},'*');
        mw.postMessage({type:'UPDATE_COLOR', value:'#f5f0eb', opacity:0.88},'*');
        if (S.cImg) mw.postMessage({type:'SET_DESIGN_IMAGE', dataUrl:S.cImg},'*');
        return;
      }
      S.vReady = true;
      var skel = document.getElementById('kzc-skeleton');
      if (skel) skel.classList.add('kzc-hidden');
      if (iframe) iframe.classList.add('kzc-ready');
      postV({type:'SET_AUTO_ROTATE', value:false});
      postV({type:'SET_ORDERS_TOKEN', proxyUrl:PROXY_URL,proxyKey:PROXY_KEY});
      postV({type:'UPDATE_COLOR', value:'#f5f0eb', opacity:0.88});
      if (S.cImg) postV({type:'SET_DESIGN_IMAGE', dataUrl:S.cImg});
    }
    if (e.data.type === 'PRINT_PNG_READY') {
      if (!window._kzcPending) return;
      window._kzcPending = false;
      clearInterval(window._kzcLoadInterval);
      clearInterval(window._kzcRetryInterval);
      clearTimeout(window._kzcTimeout);
      injectProp('_PNG imprimeur', e.data.url);
      injectProp('_source', 'ia');
      injectProp('_confirmation', '✅ Votre design est bien pris en compte');
      var lb = document.getElementById('kzc-loading-bar');
      var lo = document.getElementById('kzc-loading-overlay');
      var ltxt = document.getElementById('kzc-loading-txt');
      if (lb) lb.style.width = '100%';
      var pctElF = document.getElementById('kzc-loading-pct'); if (pctElF) pctElF.textContent = '100%';
      if (lo) lo.classList.remove('kzc-active');
      var successEl = document.getElementById('kzc-confirm-success');
      if (successEl) successEl.classList.add('kzc-visible');
      setTimeout(function(){
        window._kzcOrderDone = true;
        var form = document.querySelector('form[action*="/cart/add"]');
        if (form) form.submit();
      }, 1800);
      return;
    }
    if (e.data.type === 'PRINT_PNG_ERROR') {
      // Un échec ponctuel ne bloque plus la commande : la boucle de réessai
      // va redemander le PNG. Seul le timeout de 60 s bloque la commande.
      return;
    }
  });

  function uploadPhotoSource(dataUrl, label) {
    return new Promise(function(resolve) {
      try {
        var b64 = dataUrl.split(',')[1]; if (!b64) { resolve(null); return; }
        // ── Nom triable : compte à rebours depuis une date lointaine dans le futur,
        // + mot d'origine "ia" pour identifier ce configurateur.
        var FAR_FUTURE = 9999999999; // borne au-delà de l'année 2286, largement suffisant
        var nowSeconds = Math.floor(Date.now() / 1000);
        var inverted = String(FAR_FUTURE - nowSeconds).padStart(10, '0');
        var filename = 'orders/'+inverted+'-ia-'+SESSION_ID+'-'+label.slice(0,15)+'.png';
      fetch(PROXY_URL+'/file', {
        method:'POST',
        headers:{'Content-Type':'application/json','X-Auth-Key':PROXY_KEY},
        body:JSON.stringify({path:filename, content:b64, message:'source: '+filename})
      }).then(function(r){
        resolve(r.ok ? {url:'https://dev.code-3d.pages.dev/'+filename} : null);
      }).catch(function(){ resolve(null); });
      } catch(e){ resolve(null); }
    });
  }

  // ── BUILD FORM ──
  function buildForm() {
    var container = document.createElement('div');
    container.id = 'kzc-fields';

    // Badge Judge.me
    var jdgm = document.createElement('div');
    jdgm.style.cssText = 'margin-bottom:6px;';
    var jdgmDiv = document.createElement('div');
    jdgmDiv.className = 'jdgm-widget jdgm-preview-badge';
    jdgmDiv.setAttribute('data-id','{{ product.id }}');
    jdgmDiv.setAttribute('data-auto-install','false');
    jdgm.appendChild(jdgmDiv);
    container.appendChild(jdgm);

    // Phrase prix
    var fp = document.createElement('p');
    fp.className = 'kzc-from-price';
    fp.innerHTML = '<span style="color:#c9a96e;font-weight:600;">Dès 3,90€ le gobelet</span> <span style="color:#8a8078;">(soit 39€ les 10)</span> — plus vous en commandez, moins vous payez par gobelet';
    container.appendChild(fp);

    // Header IA
    var header = document.createElement('div');
    header.className = 'kzc-ia-header';
    // Bandeau « Comment ça marche » NON numéroté (purement explicatif),
    // en 3 grosses cartes claires. La numérotation reste sur le formulaire (1 · 2).
    header.innerHTML = '<div class="kzc-ia-header-title">🤖 KuZcup AI — créez votre gobelet unique</div>'
      +'<div class="kzc-how-heading">Comment ça marche ? En 3 étapes simples&nbsp;:</div>'
      +'<div class="kzc-how">'
      +'<div class="kzc-how-card"><div class="kzc-how-badge">✍️</div><div class="kzc-how-body"><div class="kzc-how-label">Décrivez</div><div class="kzc-how-desc">votre événement</div></div></div>'
      +'<div class="kzc-how-card"><div class="kzc-how-badge">🎨</div><div class="kzc-how-body"><div class="kzc-how-label">L’IA crée</div><div class="kzc-how-desc">votre image en 30&nbsp;s</div></div></div>'
      +'<div class="kzc-how-card"><div class="kzc-how-badge">⬆️</div><div class="kzc-how-body"><div class="kzc-how-label">Importez</div><div class="kzc-how-desc">et commandez</div></div></div>'
      +'</div>';
    container.appendChild(header);

    function setStepIndicator(n) {
      for (var i=1;i<=2;i++) {
        var el = document.getElementById('kzc-step-ind-'+i);
        if (!el) continue;
        el.classList.remove('active','done');
        if (i < n) el.classList.add('done');
        else if (i === n) el.classList.add('active');
      }
    }

    function openCard(id) {
      var target = document.getElementById(id);
      if (target) target.classList.add('active');
      setStepIndicator(parseInt(id.slice(-1)));
      return;
    }

    // ── ÉTAPE 1 — Formulaire ──
    var card1 = document.createElement('div');
    card1.className = 'kzc-step-card active';
    card1.id = 'kzc-card-1';

    var OCCASIONS = [
      'Mariage','Anniversaire enfant','Anniversaire adulte','Baptême',
      'Anniversaire de mariage','Naissance','Baby shower','Communion',
      'EVJF','EVG','Fiançailles','Demande en mariage',
      'Retraite','Diplôme / Réussite','Autre'
    ];

    var head1 = document.createElement('div');
    head1.className = 'kzc-step-head';
    head1.innerHTML = '<div class="kzc-step-num">1</div>'
      +'<div class="kzc-step-info"><div class="kzc-step-title">Décrivez votre événement</div>'
      +'<div class="kzc-step-subtitle">Prénom, occasion, thème et couleurs</div></div>';
    head1.addEventListener('click', function(){ openCard('kzc-card-1'); });

    var body1 = document.createElement('div');
    body1.className = 'kzc-step-body';

    function mkField(lbl, inp) {
      var w=document.createElement('div'); w.className='kzc-field';
      var l=document.createElement('label'); l.className='kzc-label'; l.innerHTML=lbl;
      w.appendChild(l); w.appendChild(inp);
      body1.appendChild(w);
      return inp;
    }

    var PRENOM_MAP = {
      'Mariage':['PRÉNOMS DES MARIÉS','ex : Léa & Thomas'],
      'Anniversaire enfant':['PRÉNOM DE L’ENFANT','ex : Eden'],
      'Anniversaire adulte':['PRÉNOM','ex : Allan'],
      'Baptême':['PRÉNOM DE L’ENFANT','ex : Mylann'],
      'Anniversaire de mariage':['PRÉNOMS DES MARIÉS','ex : Léa & Thomas'],
      'Naissance':['PRÉNOM DU BÉBÉ','ex : Eden'],
      'Baby shower':['PRÉNOM DE LA FUTURE MAMAN','ex : Léa'],
      'Communion':['PRÉNOM DE L’ENFANT','ex : Mylann'],
      'EVJF':['PRÉNOM DE LA FUTURE MARIÉE','ex : Léa'],
      'EVG':['PRÉNOM DU FUTUR MARIÉ','ex : Thomas'],
      'Fiançailles':['PRÉNOMS DES FIANCÉS','ex : Léa & Thomas'],
      'Demande en mariage':['PRÉNOMS','ex : Léa & Thomas'],
      'Retraite':['PRÉNOM','ex : Martine'],
      'Diplôme / Réussite':['PRÉNOM','ex : Lucas'],
      'Autre':['PRÉNOM(S)','ex : Léa & Thomas']
    };
    var prenomWrap=document.createElement('div'); prenomWrap.className='kzc-field';
    var prenomLbl=document.createElement('label'); prenomLbl.className='kzc-label';
    prenomLbl.innerHTML='PRÉNOM(S) <span class="kzc-req">*</span>';
    var inpPrenom=document.createElement('input'); inpPrenom.type='text'; inpPrenom.className='kzc-input';
    inpPrenom.placeholder='ex : Léa & Thomas';
    prenomWrap.appendChild(prenomLbl); prenomWrap.appendChild(inpPrenom);
    body1.appendChild(prenomWrap);
    var inpDate=mkField('DATE SUR LE GOBELET <span class="kzc-sublabel">(optionnel)</span>', Object.assign(document.createElement('input'),{type:'text',className:'kzc-input',placeholder:'ex : 14 juin 2026'}));
    var selEv=document.createElement('select'); selEv.className='kzc-select';
    selEv.innerHTML='<option value="">Sélectionnez un événement</option>'+OCCASIONS.map(function(o){return '<option value="'+o+'">'+o+'</option>';}).join('');
    mkField('ÉVÉNEMENT <span class="kzc-req">*</span>', selEv);

    var autreWrap=document.createElement('div'); autreWrap.className='kzc-field'; autreWrap.style.display='none';
    var autreInp=document.createElement('input'); autreInp.type='text'; autreInp.className='kzc-input';
    autreInp.placeholder='Précisez votre événement';
    var autreLabel=document.createElement('label'); autreLabel.className='kzc-label';
    autreLabel.innerHTML='PRÉCISEZ <span class="kzc-req">*</span>';
    autreWrap.appendChild(autreLabel); autreWrap.appendChild(autreInp);
    body1.appendChild(autreWrap);
    // ── THÈMES par événement (8 max) — le champ libre couvre le reste ──
    var THEME_MAP = {
      'Mariage':['Champêtre','Bohème','Floral','Méditerranéen','Nature / Végétal','Provence / Lavande','Étoiles / Céleste','Art déco'],
      'Anniversaire enfant':['Licornes / Magie','Princesses / Château','Fées / Papillons','Dinosaures','Super-héros','Sport','Animaux mignons','Jungle / Safari'],
      'Anniversaire adulte':['Festif','Tropical','Musique / Fête','Voyage','Art déco','Géométrique','Sport','Nature / Végétal'],
      'Baptême':['Floral','Fées / Papillons','Bohème','Marin / Petit bateau','Nature / Végétal','Champêtre','Croix / Religieux','Étoiles / Céleste'],
      'Anniversaire de mariage':['Floral','Champêtre','Art déco','Méditerranéen','Étoiles / Céleste','Nature / Végétal'],
      'Naissance':['Floral','Fées / Papillons','Licornes / Magie','Marin / Petit bateau','Espace / Étoiles','Petits dinosaures','Animaux mignons','Nature / Végétal'],
      'Baby shower':['Floral','Fées / Papillons','Licornes / Magie','Marin / Petit bateau','Espace / Étoiles','Petits dinosaures','Animaux mignons','Nature / Végétal'],
      'Communion':['Floral','Couronne de fleurs','Colombe','Épis de blé','Vitrail','Nature / Végétal','Croix / Religieux','Étoiles / Céleste'],
      'EVJF':['Tropical','Bohème','Floral','Festif','Méditerranéen','Musique / Fête'],
      'EVG':['Festif','Marin','Tropical','Sport','Musique / Fête','Montagne / Chalet'],
      'Fiançailles':['Floral','Bohème','Champêtre','Étoiles / Céleste','Méditerranéen','Art déco'],
      'Demande en mariage':['Floral','Étoiles / Céleste','Bohème','Champêtre','Méditerranéen'],
      'Retraite':['Voyage','Nature / Végétal','Marin','Montagne / Chalet','Festif','Gourmandise'],
      'Diplôme / Réussite':['Festif','Géométrique','Étoiles / Céleste','Musique / Fête','Voyage'],
      'Autre':['Champêtre','Bohème','Tropical','Floral','Festif','Nature / Végétal','Étoiles / Céleste']
    };
    var THEME_DEFAUT = ['Champêtre','Bohème','Tropical','Floral','Festif','Nature / Végétal','Étoiles / Céleste'];

    // ── 6 STYLES ARTISTIQUES VALIDÉS (le rendu, distinct du thème) ──
    // Base = 5 styles disponibles partout. Cartoon RÉSERVÉ aux enfants :
    // uniquement « Anniversaire enfant » et « Baptême » — jamais un mariage.
    var STYLE_BASE   = ['Aquarelle','Ligne fine','Peinture-gouache','Pop art'];
    var STYLE_ENFANT = STYLE_BASE.concat(['Cartoon']);
    var STYLE_MAP = {
      'Mariage':STYLE_BASE,
      'Fiançailles':STYLE_BASE,
      'Demande en mariage':STYLE_BASE,
      'Communion':STYLE_BASE,
      'Anniversaire enfant':STYLE_ENFANT,
      'Anniversaire adulte':STYLE_BASE,
      'Baptême':STYLE_ENFANT,
      'Naissance':STYLE_BASE,
      'Baby shower':STYLE_BASE,
      'Anniversaire de mariage':STYLE_BASE,
      'Retraite':STYLE_BASE,
      'EVJF':STYLE_BASE,
      'EVG':STYLE_BASE,
      'Diplôme / Réussite':STYLE_BASE,
      'Autre':STYLE_BASE
    };
    var STYLE_DEFAUT = STYLE_BASE;

    // Reconstruit les puces d'un conteneur à partir d'une liste.
    function kzBuildChips(chipsEl, liste, opts) {
      opts = opts || {};
      var avant = chipsEl.querySelector('.kzc-chip.sel');
      var avantVal = avant ? avant.getAttribute('data-v') : null;
      chipsEl.innerHTML = '';
      liste.forEach(function(t) {
