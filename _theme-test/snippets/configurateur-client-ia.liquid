    // ── ORDRE FINAL : l'événement d'abord, il commande tout le reste ──
    (function kzOrdre(){
      var evWrap = selEv.parentNode;
      var dateWrap = inpDate.parentNode;
      var couleursWrap = inpCouleurs.parentNode;
      var ecritureWrap = selEcriture.parentNode;
      var phraseWrap = inpPhrase.parentNode;
      var eviterWrap = inpEviter.parentNode;

      // Menu déroulant « Options avancées » : on n'y montre que les réglages de rendu (la date en a été sortie)
      // pour ne garder que l'essentiel visible (événement, prénom, thème, style).
      var adv = document.createElement('details'); adv.className = 'kzc-adv';
      var advSum = document.createElement('summary'); advSum.className = 'kzc-adv-summary';
      advSum.innerHTML = '⚙️ Options avancées <span class="kzc-adv-hint">(couleurs, écriture, mot en plus — facultatif)</span>';
      adv.appendChild(advSum);
      adv.appendChild(couleursWrap);
      adv.appendChild(ecritureWrap);
      adv.appendChild(phraseWrap);
      adv.appendChild(eviterWrap);

      // Essentiel visible d'abord, puis le repliable, puis le bouton.
      var facesWrap = selFaces.parentNode;
      [evWrap, autreWrap, prenomWrap, detailWrap, nocesWrap, dipWrap, genreWrap,
       dateWrap, themeWrap, styleWrap, facesWrap, versoWrap, adv, errMsg, copyWrap]
        .forEach(function(el){ if (el) body1.appendChild(el); });
      // Au départ, aucun événement choisi : on masque les champs spécifiques.
      detailWrap.style.display = 'none';
    })();

    card1.appendChild(head1); card1.appendChild(body1);
    container.appendChild(card1);

    // ── ÉTAPE 2 — Importer ──
    var card2=document.createElement('div'); card2.className='kzc-step-card active'; card2.id='kzc-card-2';
    var head2=document.createElement('div'); head2.className='kzc-step-head';
    head2.innerHTML='<div class="kzc-step-num">2</div>'
      +'<div class="kzc-step-info"><div class="kzc-step-title">Importer mon design</div>'
      +'<div class="kzc-step-subtitle">Déposez votre PNG ici pour l’apercevoir sur le gobelet</div></div>';
    head2.addEventListener('click',function(){openCard('kzc-card-2');});
    var body2=document.createElement('div'); body2.className='kzc-step-body';

    var upzone=document.createElement('div'); upzone.className='kzc-upzone'; upzone.id='kzc-upz';
    var upInner=document.createElement('div'); upInner.className='kzc-upzone-inner';
    upInner.innerHTML='<div class="kzc-upico">📁</div>'
      +'<div class="kzc-uptit">Déposez votre design ici</div>'
      +'<div class="kzc-upsub">Déposez ici le visuel généré par l’IA</div>';
    var upInp=document.createElement('input'); upInp.type='file'; upInp.accept='image/*';
    var upFn=document.createElement('div'); upFn.className='kzc-upfn'; upFn.id='kzc-upfn';
    var upMsg=document.createElement('div'); upMsg.className='kzc-upmsg'; upMsg.id='kzc-upmsg';

    upzone.appendChild(upInner); upzone.appendChild(upInp);
    body2.appendChild(upzone); body2.appendChild(upFn); body2.appendChild(upMsg);

    upInp.addEventListener('change',function(){
      var file=upInp.files[0]; if(!file) return;
      var reader=new FileReader();
      reader.onload=function(ev){
        var img=new Image();
        img.onload=function(){
          var ratio=img.naturalWidth/(img.naturalHeight||1);
          if (ratio<1.0||ratio>2.5) {
            upMsg.textContent='⚠️ Ce fichier n’est pas au bon format. Il faut un rectangle large, au format 16:9 — pas un carré, pas une image verticale.';
            upMsg.className='kzc-upmsg err'; upMsg.style.display='block';
            upMsg.style.cssText=''; upInp.value=''; return;
          }
          /* KZ 13/09 — AVERTISSEMENT DE PROPORTIONS, NON BLOQUANT.
             Le test ci-dessus ne refuse que le portrait et l'ultra-panoramique.
             Une image CARRÉE vaut exactement 1.0 : elle passait donc sans un mot,
             alors que c'est la sortie par défaut de ChatGPT et de Gemini.
             On ne bloque pas — décision d'Allan, la commande doit passer — mais
             le client est prévenu que son visuel sera rogné.
             Tolérance 5 % : le 16/9 (2,9 % d'écart) passe sans alerte, le carré
             (42 %) et le 4/3 (23 %) la déclenchent.
             Pour désactiver : supprimer ce bloc, rien d'autre n'en dépend. */
          var kzEcart = Math.abs(ratio - (1970/1140)) / (1970/1140);
          if (kzEcart > 0.05) {
            upMsg.className = 'kzc-upmsg';
            upMsg.style.cssText = 'display:block;margin-top:10px;padding:12px 14px;'
              + 'border:1.5px solid #C9821E;border-radius:10px;background:#FFF6E8;'
              + 'color:#7A4E0B;font-size:13px;font-weight:600;line-height:1.5;text-align:left;';
            upMsg.innerHTML = '⚠️ <b>Votre image n’a pas la forme du gobelet.</b><br>'
              + 'Le gobelet est panoramique : le haut et le bas de votre visuel seront rognés '
              + 'à l’impression. Regardez l’aperçu 3D ci-contre pour juger du résultat.<br>'
              + 'Pour un rendu fidèle, redemandez à votre IA la même image '
              + '<b>au format 16:9</b>. Vous pouvez aussi commander ainsi : nous vérifions '
              + 'avant impression.';
          } else {
            upMsg.style.cssText = '';
            upMsg.className = 'kzc-upmsg';
            upMsg.style.display = 'none';
          }
          S.cImg=ev.target.result; S.cName=file.name;
          upzone.classList.add('has');
          upFn.textContent='✅ '+file.name; upFn.style.display='block';
          card2.classList.add('done');
          var n2=card2.querySelector('.kzc-step-num'); if(n2) n2.textContent='✓';
          setStepIndicator(3);
          if (S.vReady) postV({type:'SET_DESIGN_IMAGE', dataUrl:S.cImg});
        };
        img.src=ev.target.result;
      };
      reader.readAsDataURL(file);
    });

    card2.appendChild(head2); card2.appendChild(body2);
    container.appendChild(card2);

    // ── PANNEAU INFOS UNIFIÉ ──
    var infoPanel = document.createElement('div');
    infoPanel.style.cssText = 'background:#fff;border:1px solid rgba(201,169,110,0.3);border-radius:12px;overflow:hidden;margin-bottom:12px;';

    var KZ_ICON_BULB  = '<svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 21h4"/><path d="M8.5 15a5 5 0 1 1 7 0c-.7.6-1 1.2-1 2H9.5c0-.8-.3-1.4-1-2z"/></svg>';
    var KZ_ICON_BRUSH = '<svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 4-2 4-4a2 2 0 0 0-2-2c-2 0-3 2-2 6z"/><path d="M7 15l9-9a2.1 2.1 0 0 1 3 3l-9 9"/></svg>';
    var KZ_ICON_INFO  = '<svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/></svg>';
    var KZ_ICON_LEAF  = '<svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21c0-9 5-14 15-14 0 8-5 13-13 13"/><path d="M5 21c1-4 3-6 6-7"/></svg>';

    function kzInfoRow(iconSvg, iconColor, title, text, withDivider) {
      return (withDivider ? '<div style="height:1px;background:#f0ece5;margin:0 16px;"></div>' : '')
        + '<div style="display:flex;align-items:flex-start;gap:12px;padding:15px 16px;">'
        +   '<span style="color:' + iconColor + ';flex-shrink:0;line-height:1.2;display:flex;">' + iconSvg + '</span>'
        +   '<div>'
        +     '<div style="font-size:13px;font-weight:700;color:#1c1c1c;margin-bottom:2px;">' + title + '</div>'
        +     '<div style="font-size:12.5px;color:#5a4a30;line-height:1.55;">' + text + '</div>'
        +   '</div>'
        + '</div>';
    }

    infoPanel.innerHTML =
        kzInfoRow(KZ_ICON_BULB, '#c9a96e', 'Toutes vos idées sont permises',
          'Écrivez librement votre thème — « PSG », « Harry Potter »… L’IA s’en inspire sans copier de logo ni de personnage protégé : vous obtenez un design original, dans le même esprit.', false)
      + kzInfoRow(KZ_ICON_INFO, '#c9a96e', 'Format standard 25/33cl',
          'Ce configurateur est prévu pour le gobelet standard. Pour une autre contenance, <a href="mailto:' + CONTACT_EMAIL + '" style="color:#c9a96e;text-decoration:none;">contactez notre équipe</a>.', true);

    container.appendChild(infoPanel);

    // Date événement
    var dw=document.createElement('div'); dw.className='kzc-date-wrap';
    dw.innerHTML='<div class="kzc-date-title">📅 Date de votre événement <span style="font-weight:400;font-size:11px;color:#8a8078;">(optionnel)</span></div>';
    var dateInp=document.createElement('input'); dateInp.type='date'; dateInp.className='kzc-input'; dateInp.id='kuztom-event-date';
    dateInp.style.cssText='width:100%;max-width:154px;margin-bottom:4px;';
    var dateTxt=document.createElement('p'); dateTxt.style.cssText='font-size:11px;color:#8a8078;margin:4px 0 0;';
    dateTxt.textContent='Optionnel — nous aide à tout organiser pour une livraison sereine avant le jour J.';
    dateInp.addEventListener('change',function(){S.eventDate=dateInp.value; updateProps();});
    dw.appendChild(dateInp); dw.appendChild(dateTxt);
    container.appendChild(dw);
    // Livraison : ligne retirée — doublon du bloc « Réception estimée » de kz-fiche.
    // Prix degressif (info)
    var dg=document.createElement('div');
    dg.style.cssText='margin-top:6px;font-size:13px;color:#5c554e;line-height:1.4;';
    dg.textContent='Plus vous en commandez, moins c’est cher par gobelet.';
    container.appendChild(dg);

    // Injection dans .product-info
    function doInject(t) {
      if (document.contains(container)) return;
      var pb=t.querySelector('[data-block-type="price"]');
      if (pb&&pb.parentNode===t) t.insertBefore(container,pb);
      else t.prepend(container);
      // Retire le trait + l'espace juste au-dessus de « Dès 39€ »
      // (bordure/marge du bloc note-avis « 5.0 ★ » du thème, placé juste avant).
      container.style.marginTop='0';
      var prev=container.previousElementSibling;
      if (prev) {
        prev.style.borderBottom='none';
        prev.style.marginBottom='0';
        prev.style.paddingBottom='0';
      }
    }
    var tgt=document.querySelector('.product-info');
    if (tgt) { doInject(tgt); return; }
    var obs=new MutationObserver(function(ml,o){
      var t=document.querySelector('.product-info');
      if(t){o.disconnect();doInject(t);}
    });
    obs.observe(document.body,{childList:true,subtree:true});
    setTimeout(function(){
      var t=document.querySelector('.product-info')||document.querySelector('safe-sticky');
      if(t){obs.disconnect();doInject(t);}
    },1200);
  }

  // Récapitulatif
  function kzcEsc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function kzcFmtEuro(cents) {
    return (cents / 100).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
  }

  function kzcFmtDate(v) {
    var d = String(v).split('-');
    var mois = ['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'];
    if (d.length === 3 && mois[parseInt(d[1], 10) - 1]) {
      return parseInt(d[2], 10) + ' ' + mois[parseInt(d[1], 10) - 1] + ' ' + d[0];
    }
    return v;
  }

  function kzcGetPrice(variants) {
    var cents = null;
    try {
      var sc = document.querySelector('variant-picker script[data-variant]');
      if (sc && sc.textContent.trim()) {
        var vd = JSON.parse(sc.textContent);
        if (vd && typeof vd.price === 'number') cents = vd.price;
      }
    } catch (e) {}
    try {
      if (window.KZ_PRODUCT && window.KZ_PRODUCT.prices && variants && variants.length >= 2) {
        var k = variants[0].value + '||' + variants[1].value;
        var p = window.KZ_PRODUCT.prices[k];
        if (typeof p === 'number') cents = p;
      }
    } catch (e) {}
    return cents;
  }

  function getVariants() {
    var results = [];
    document.querySelectorAll('fieldset.variant-picker__option').forEach(function(fs) {
      var leg = fs.querySelector('legend');
      var optName = leg ? leg.textContent.replace(/\s*:.*/,'').trim() : '';
      var checked = fs.querySelector('input[type="radio"]:checked');
      if (checked) {
        var lbl = checked.closest('label');
        if (!lbl && checked.id) lbl = document.querySelector('label[for="'+checked.id+'"]');
        if (lbl) {
          var clone = lbl.cloneNode(true);
          clone.querySelectorAll('.sr-only,.visually-hidden').forEach(function(el){el.remove();});
          var val = clone.textContent.trim();
          if (val && optName) results.push({label:optName, value:val});
        }
      }
    });
    return results;
  }

  function showRecap() {
    var overlay=document.getElementById('kzp-overlay');
    var body=document.getElementById('kzp-body');
    if (!overlay||!body) return false;
    var html='';
    if (S.cImg) html+='<img src="'+S.cImg+'" class="kzp-img-preview" alt="Aperçu">';

    var variants = getVariants();
    var qteVariant = null;
    variants.forEach(function(v){ if(/quant/i.test(v.label)) qteVariant = v; });
    html+='<div class="kzp-section"><div class="kzp-section-title">Votre commande</div>';
    html+='<div class="kzp-row"><span class="kzp-label">Produit</span><span class="kzp-val">'+kzcEsc({{ product.title | json }})+'</span></div>';
    if (qteVariant) {
      html+='<div class="kzp-row"><span class="kzp-label">'+qteVariant.label+'</span><span class="kzp-val">'+qteVariant.value+'</span></div>';
    }
    var kzCents = kzcGetPrice(variants);
    if (kzCents !== null) {
      var kzQty = qteVariant ? (parseInt(qteVariant.value, 10) || 0) : 0;
      var kzTxt = kzcFmtEuro(kzCents);
      if (kzQty > 0) kzTxt += ' (' + kzcFmtEuro(kzCents / kzQty) + ' / gobelet)';
      html+='<div class="kzp-row"><span class="kzp-label">Prix</span><span class="kzp-val">'+kzTxt+'</span></div>';
    }
    var kzDateEl = document.getElementById('kuztom-event-date');
    if (kzDateEl && kzDateEl.value) {
      html+='<div class="kzp-row"><span class="kzp-label">Date de l’événement</span><span class="kzp-val">'+kzcFmtDate(kzDateEl.value)+'</span></div>';
    }
    html+='</div>';
html+='<div class="kzp-section"><div class="kzp-section-title">Caractéristiques du gobelet</div>';
    html+='<div class="kzp-row"><span class="kzp-label">Contenance</span><span class="kzp-val">25/33cl</span></div>';
    html+='<div class="kzp-row"><span class="kzp-label">Couleur</span><span class="kzp-val">Translucide</span></div>';
    html+='</div>';

    body.innerHTML=html;
    overlay.classList.add('kzp-open');
    return true;
  }

  // Interception panier — via clic direct sur le bouton (résiste au remplacement du formulaire par Shopify)
  window._kuztomHandlePrintSubmitIA = function(clickEvent) {
    var btn = clickEvent.target.closest('button[type="submit"], input[type="submit"], [name="add"]');
    if (!btn) return;
    var form = btn.closest('form[action*="/cart/add"]') || document.querySelector('form[action*="/cart/add"]');
    if (!form) return;

    if (window._kzcPending) { clickEvent.preventDefault(); clickEvent.stopPropagation(); return; }
    if (window._kzcOrderDone) return;

    clickEvent.preventDefault();
    clickEvent.stopPropagation();
    if (window._kzcPngRequested) return;   // un essai est déjà lancé ; « Réessayer » réarme ce verrou
    updateProps();
    var shown = showRecap();
    if (!shown) { confirmOrder(form); return; }
    var kzpOv = document.getElementById('kzp-overlay');
    // Clic sur le fond (hors modale) ou touche Échap : on referme.
    kzpOv.onclick = function(e){ if (e.target === kzpOv) kzpOv.classList.remove('kzp-open'); };
    if (!window._kzpEscBound) {
      window._kzpEscBound = true;
      document.addEventListener('keydown', function(e){ if (e.key === 'Escape') kzpOv.classList.remove('kzp-open'); });
    }
    document.getElementById('kzp-cancel').onclick = function(){
      kzpOv.classList.remove('kzp-open');
    };
    document.getElementById('kzp-confirm').onclick = function(){
      document.getElementById('kzp-overlay').classList.remove('kzp-open');
      confirmOrder(form);
    };
  };

  function initCart() {
    // Écouteur unique sur document, en phase de capture : peu importe que Shopify
    // remplace le formulaire (ex: changement de quantité), le bon formulaire est
    // retrouvé au moment même du clic, jamais à l'avance.
    document.addEventListener('click', window._kuztomHandlePrintSubmitIA, true);
  }

  function confirmOrder(form) {
    var lo=document.getElementById('kzc-loading-overlay');
    var lb=document.getElementById('kzc-loading-bar');
    var ltxt=document.getElementById('kzc-loading-txt');
    if (lo) lo.classList.add('kzc-active');
    window._kzcPending=true;
    window._kzcPngRequested=true;

    // Barre de progression avec messages
    window._kzcLoadInterval = startLoadingAnimation(lb, ltxt);

    // ── Boucle de réessai : redemande le PNG au GRAND iframe uniquement,
    //    toutes les 8 s, tant que le viewer n'est pas prêt / que le PNG
    //    n'est pas revenu. S'arrête dès réception de PRINT_PNG_READY.
    function requestPng() {
      if (!window._kzcPending) return;   // déjà résolu → on n'envoie plus rien
      if (!S.vReady) return;             // viewer pas encore prêt → on retentera au prochain tick
      if (iframe&&iframe.contentWindow) iframe.contentWindow.postMessage({type:'REQUEST_PRINT_PNG', proxyUrl:PROXY_URL,proxyKey:PROXY_KEY, origin:'ia'},'*');
    }
    requestPng();                        // tentative immédiate
    window._kzcRetryInterval = setInterval(requestPng, 8000);

    // Timeout 60s — si pas de PNG → erreur, la commande ne part PAS
    window._kzcTimeout = setTimeout(function(){
      if (window._kzcPending) {
        window._kzcPending=false;
        clearInterval(window._kzcLoadInterval);
        clearInterval(window._kzcRetryInterval);
        if (lo) lo.classList.remove('kzc-active');
        var errEl = document.getElementById('kzc-timeout-error');
        if (errEl) errEl.classList.add('kzc-visible');
        var retryBtn = document.getElementById('kzc-error-retry');
        if (retryBtn) retryBtn.addEventListener('click', function() {
          if (errEl) errEl.classList.remove('kzc-visible');
          window._kzcPngRequested=false;
          window._kzcPending=false;
        });
      }
    },60000);
  }

  // maskContenance
  function maskContenance() {
    document.querySelectorAll('fieldset, .product-form__option').forEach(function(el){
      var txt=(el.getAttribute('data-option-name')||'')+(el.textContent||'');
      if (/contenance/i.test(txt)) el.style.display='none';
    });
  }
  setTimeout(maskContenance,200);
  setTimeout(maskContenance,600);
  setTimeout(maskContenance,1200);
  var _mc=new MutationObserver(function(){maskContenance();});
  _mc.observe(document.body,{childList:true,subtree:true});

  buildForm();
  initCart();
});
</script>