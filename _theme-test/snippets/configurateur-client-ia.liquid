<style>
*, *::before, *::after { box-sizing: border-box; }

/* ── SKELETON & VIEWER ── */
#kzc-iframe-wrap {
  width:100%;position:relative;overflow:hidden;border-radius:16px;
  background:#faf8f5;
}
/* Sur ordinateur, le gobelet reste visible pendant que le formulaire défile. */
@media (min-width:1000px) {
  #kzc-iframe-wrap { position:sticky; top:90px; z-index:1; }
}
#kzc-iframe-wrap iframe {
  width:100%;height:100%;border:none;display:block;
  opacity:0;transition:opacity .6s ease;position:absolute;inset:0;
}
#kzc-iframe-wrap iframe.kzc-ready { opacity:1; }
#kzc-skeleton {
  position:absolute;inset:0;display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:20px;
  background:#faf8f5;
  transition:opacity .4s ease;z-index:2;
}
#kzc-skeleton.kzc-hidden { opacity:0;pointer-events:none; }
.kzc-skel-gobelet {
  animation:kzc-pulse 2s ease-in-out infinite;
  width:62%;max-width:320px;height:auto;display:block;
}
#kzc-skel-text {
  margin-top:18px;font-size:13px;color:#c9a96e;
  letter-spacing:.08em;font-family:inherit;
  animation:kzc-pulse 2s ease-in-out infinite;
}
@keyframes kzc-pulse { 0%,100%{opacity:.45} 50%{opacity:1} }

/* ── MINI VIEWER ── */
#kzc-mini-viewer {
  display:none;
  position:fixed;
  top:10px;
  left:50%;
  transform:translateX(-50%);
  width:144px;
  height:144px;
  border-radius:50%;
  border:2.5px solid #c9a96e;
  background:rgba(255,255,255,0.72);
  backdrop-filter:blur(8px);
  -webkit-backdrop-filter:blur(8px);
  box-shadow:0 4px 20px rgba(201,169,110,0.25), 0 2px 8px rgba(0,0,0,0.1);
  overflow:hidden;
  cursor:pointer;
  z-index:9999;
}
@media(min-width:768px){#kzc-mini-viewer{display:none !important;}}
/* Le mini-aperçu flottant passait par-dessus le récapitulatif : on le masque tant que la modale est ouverte. */
body:has(.kzp-overlay.kzp-open) #kzc-mini-viewer { display:none !important; }
#kzc-mini-viewer iframe {
  position:absolute;
  top:0;
  left:-1px;
  width:686px !important;
  height:686px !important;
  transform:scale(0.21);
  transform-origin:top left;
  pointer-events:none;
  border:none;
}

/* ── CONTAINER GÉNÉRAL ── */
#kzc-fields { display:flex;flex-direction:column;gap:0;margin-bottom:10px; }

/* ── PHRASE PRIX ── */
.kzc-from-price {
  font-size:13px;color:#8a8078;margin-bottom:14px;line-height:1.5;
}

/* ── HEADER SECTION IA ── */
.kzc-ia-header { margin-bottom:20px; }
.kzc-ia-header-title {
  font-size:18px;font-weight:700;color:#1c1c1c;margin-bottom:4px;
  display:flex;align-items:center;gap:8px;
}
.kzc-ia-header-sub { font-size:12px;color:#8a8078;line-height:1.5; }
.kzc-ia-header-steps {
  display:flex;align-items:center;gap:6px;margin-top:10px;
  font-size:11px;color:#8a8078;
}
.kzc-ia-header-step {
  display:flex;align-items:center;gap:5px;
  padding:4px 10px;border-radius:20px;
  background:#f0ede8;color:#5a4a30;font-weight:600;font-size:11px;
  transition:all .3s;
}
.kzc-ia-header-step.active {
  background:rgba(201,169,110,0.15);color:#c9a96e;
  border:1px solid rgba(201,169,110,0.3);
}
.kzc-ia-header-step.done { background:rgba(60,160,80,0.1);color:#2d7a2d; }
.kzc-step-sep { color:#e0dbd4;font-size:12px; }

/* ── ÉTAPES ── */
.kzc-step-card {
  border:1.5px solid #e0dbd4;border-radius:16px;
  background:#fdfcfb;overflow:hidden;
  transition:all .3s;margin-bottom:12px;
}
.kzc-step-card.active {
  border-color:rgba(201,169,110,0.5);
  box-shadow:0 4px 20px rgba(201,169,110,0.12);
}
.kzc-step-card.done {
  border-color:rgba(60,160,80,0.3);background:#fafffe;
}
.kzc-step-head {
  display:flex;align-items:center;gap:14px;
  padding:16px 18px;cursor:pointer;
}
.kzc-step-num {
  width:36px;height:36px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:15px;font-weight:800;flex-shrink:0;
  background:rgba(201,169,110,0.1);color:#c9a96e;
  border:1.5px solid rgba(201,169,110,0.25);transition:all .3s;
}
.kzc-step-card.done .kzc-step-num {
  background:rgba(60,160,80,0.1);color:#2d7a2d;
  border-color:rgba(60,160,80,0.3);font-size:18px;
}
.kzc-step-card.active .kzc-step-num {
  background:#c9a96e;color:#fff;border-color:#c9a96e;
}
.kzc-step-info { flex:1; }
.kzc-step-title { font-size:14px;font-weight:700;color:#1c1c1c;margin-bottom:2px; }
.kzc-step-subtitle { font-size:12px;color:#8a8078; }
.kzc-step-body { padding:0 18px 18px;display:none; }
.kzc-step-card.active .kzc-step-body { display:block; }

/* ── FORMULAIRE ── */
.kzc-field { margin-bottom:14px; }
.kzc-label {
  font-size:10px;font-weight:700;letter-spacing:1.2px;
  text-transform:uppercase;color:#1c1c1c;display:block;margin-bottom:5px;
}
.kzc-sublabel { font-weight:400;text-transform:none;letter-spacing:0;color:#8a8078;font-style:italic; }
.kzc-req { color:#c9a96e; }
.kzc-input {
  width:100%;padding:10px 13px;border:1.5px solid #e0dbd4;
  border-radius:10px;font-size:16px;font-family:inherit;outline:none;
  transition:border-color .15s,box-shadow .15s;background:#fff;
}
.kzc-input:focus {
  border-color:#c9a96e;box-shadow:0 0 0 3px rgba(201,169,110,0.1);
}
.kzc-select {
  width:100%;padding:10px 13px;border:1.5px solid #e0dbd4;
  border-radius:10px;font-size:16px;font-family:inherit;outline:none;
  background:#fff;cursor:pointer;transition:border-color .15s;
}
.kzc-select:focus { border-color:#c9a96e; }

/* ── PUCES (thème / style) ── */
.kzc-chips { display:flex;flex-wrap:wrap;gap:7px;margin-bottom:9px; }
.kzc-chip {
  border:1.5px solid #e0dbd4;background:#fff;font-size:13px;
  padding:6px 13px;border-radius:20px;color:#5a5249;cursor:pointer;
  font-family:inherit;transition:all .15s;
}
.kzc-chip:hover { border-color:#c9a96e; }
.kzc-chip.sel { border-color:#c9a96e;background:rgba(201,169,110,0.14);color:#8a6d3b;font-weight:600; }
.kzc-chip.kzc-chip-surprise { border-style:dashed;color:#8a6d3b; }

/* ── BOUTONS IA ── */
/* ── BOUTON COPIER POUR MON IA ── */
.kzc-copy-btn-wrap { margin-top:16px; }
.kzc-copy-main-btn {
  width:100%;padding:16px 20px;
  background:linear-gradient(135deg,#1a1a2e 0%,#16213e 50%,#0f3460 100%);
  color:#fff;border:none;border-radius:14px;
  font-size:17px;font-weight:800;cursor:pointer;font-family:inherit;
  display:flex;align-items:center;justify-content:center;gap:10px;
  box-shadow:0 4px 24px rgba(15,52,96,0.45),0 1px 4px rgba(0,0,0,0.2);
  transition:transform .15s,box-shadow .15s;
  letter-spacing:0.02em;position:relative;overflow:hidden;
}
.kzc-copy-main-btn::before {
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(255,255,255,0.08),transparent);
  border-radius:14px;
}
.kzc-copy-main-btn:hover { transform:translateY(-2px);box-shadow:0 8px 32px rgba(15,52,96,0.55),0 2px 8px rgba(0,0,0,0.2); }
.kzc-copy-main-btn:active { transform:translateY(0); }
.kzc-copy-main-btn.copied {
  background:linear-gradient(135deg,#1a5c1a,#2d7a2d) !important;
  box-shadow:0 4px 24px rgba(45,122,45,0.5) !important;
  animation:kzc-btn-pulse .4s ease;
}
@keyframes kzc-btn-pulse {
  0%{transform:scale(1)} 40%{transform:scale(1.04)} 100%{transform:scale(1)}
}
.kzc-copy-main-btn .kzc-btn-icon { font-size:20px;transition:transform .3s; }
.kzc-copy-main-btn.copied .kzc-btn-icon { transform:scale(1.3); }
.kzc-copy-main-btn.invalid {
  background:linear-gradient(135deg,#b45a00,#d4730a) !important;
  box-shadow:0 4px 24px rgba(180,90,0,0.4) !important;
  animation:kzc-btn-pulse .4s ease;
}
.kzc-copy-success-msg {
  display:none;margin-top:12px;padding:12px 16px;
  background:linear-gradient(135deg,rgba(45,122,45,0.1),rgba(45,122,45,0.05));
  border:1.5px solid rgba(45,122,45,0.3);border-radius:10px;
  font-size:13px;color:#2d7a2d;line-height:1.6;text-align:center;
}
.kzc-copy-success-msg.visible { display:block; }
.kzc-copy-hint {
  font-size:12px;color:#8a8078;text-align:center;
  margin-top:10px;line-height:1.6;
}
@keyframes kzc-shimmer { 0%{transform:translateX(-100%)} 60%,100%{transform:translateX(100%)} }

.kzc-ai-note {
  font-size:11px;color:#8a8078;text-align:center;margin-top:8px;line-height:1.6;
}
.kzc-ai-err {
  font-size:12px;color:#c0392b;text-align:center;
  display:none;margin-top:8px;padding:8px 12px;
  background:#fff0f0;border-radius:8px;border:1px solid #f5c6c6;
}

/* ── ZONE UPLOAD ── */
.kzc-upzone {
  border:2px dashed #c9a96e;border-radius:14px;
  padding:30px 20px;text-align:center;cursor:pointer;
  transition:all .25s;background:#fff;position:relative;
}
.kzc-upzone:hover,.kzc-upzone.has {
  border-color:#c9a96e;background:rgba(201,169,110,0.04);
}
.kzc-upzone.has { border-style:solid; }
.kzc-upzone input { position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%; }
.kzc-upzone-inner { pointer-events:none; }
.kzc-upico { font-size:36px;margin-bottom:8px; }
.kzc-uptit { font-size:14px;font-weight:700;color:#1c1c1c;margin-bottom:4px; }
.kzc-upsub { font-size:12px;color:#8a8078; }
.kzc-upfn { font-size:13px;color:#2d7a2d;margin-top:8px;display:none;font-weight:600; }
.kzc-upmsg { font-size:12px;margin-top:8px;display:none;padding:8px 12px;border-radius:8px; }
.kzc-upmsg.err { background:#fff0f0;border:1.5px solid #c0392b;color:#c0392b; }

/* ── ENCARTS ── */
.kzc-ibox {
  padding:12px 14px;background:rgba(201,169,110,0.06);
  border:1px solid rgba(201,169,110,0.25);border-radius:10px;
  font-size:13px;color:#5a4a30;line-height:1.6;margin-bottom:10px;
}
.kzc-eco-box {
  padding:12px 14px;background:rgba(122,158,126,0.09);
  border:1px solid rgba(122,158,126,0.3);border-radius:10px;
  font-size:13px;color:#3a5c42;line-height:1.6;margin-bottom:10px;
}
.kzc-date-wrap {
  padding:12px 14px;background:#faf8f5;
  border:1.5px solid #e8e2db;border-radius:10px;margin-bottom:10px;
}
.kzc-date-title { font-size:12px;font-weight:700;color:#c9a96e;margin-bottom:6px; }

/* ── LOADING ── */
.kzc-loading-overlay {
  display:none;position:fixed;inset:0;
  background:rgba(253,252,251,0.94);z-index:9999;
  flex-direction:column;align-items:center;justify-content:center;gap:16px;
  backdrop-filter:blur(4px);
}
.kzc-loading-overlay.kzc-active { display:flex; }
.kzc-loading-bar-wrap {
  width:220px;height:4px;background:#e0dbd4;border-radius:4px;overflow:hidden;
}
.kzc-loading-bar {
  height:100%;width:0;background:linear-gradient(90deg,#c9a96e,#e8c87a);
  border-radius:4px;transition:width .3s;
}
.kzc-loading-txt { font-size:13px;color:#8a8078;font-family:inherit; }
.kzc-loading-pulse { animation:kzc-loading-blink 1.2s ease-in-out infinite; }
@keyframes kzc-loading-blink { 0%,100%{opacity:1} 50%{opacity:0.4} }

/* ── ERREUR TIMEOUT ── */
#kzc-timeout-error {
  display:none;position:fixed;inset:0;z-index:10001;
  background:rgba(253,252,251,0.97);
  flex-direction:column;align-items:center;justify-content:center;gap:18px;
  backdrop-filter:blur(6px);padding:30px;
}
#kzc-timeout-error.kzc-visible { display:flex; }
.kzc-error-circle {
  width:80px;height:80px;border-radius:50%;
  background:linear-gradient(135deg,#c0392b,#e74c3c);
  display:flex;align-items:center;justify-content:center;
  animation:kzc-success-ping 0.6s ease-out forwards;
}
.kzc-error-icon { font-size:38px;color:#fff; }
.kzc-error-title { font-size:20px;font-weight:800;color:#1c1c1c;text-align:center; }
.kzc-error-sub { font-size:14px;color:#5a4a30;text-align:center;line-height:1.7;max-width:300px; }
.kzc-error-btn {
  padding:13px 28px;background:#1c1c1c;color:#fff;border:none;
  border-radius:12px;font-size:14px;font-weight:700;cursor:pointer;
  font-family:inherit;margin-top:6px;
}
.kzc-error-btn:hover { opacity:.88; }

/* ── CONFIRMATION VERTE ── */
#kzc-confirm-success {
  display:none;position:fixed;inset:0;z-index:10000;
  background:rgba(253,252,251,0.97);
  flex-direction:column;align-items:center;justify-content:center;gap:18px;
  backdrop-filter:blur(6px);
}
#kzc-confirm-success.kzc-visible { display:flex; }
.kzc-success-circle {
  width:80px;height:80px;border-radius:50%;
  background:linear-gradient(135deg,#2d7a2d,#3aa03a);
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 0 0 0 rgba(45,122,45,0.4);
  animation:kzc-success-ping 1s ease-out forwards;
}
@keyframes kzc-success-ping {
  0%  { transform:scale(0.6); opacity:0; box-shadow:0 0 0 0 rgba(45,122,45,0.5); }
  60% { transform:scale(1.1); opacity:1; box-shadow:0 0 0 18px rgba(45,122,45,0); }
  100%{ transform:scale(1);   opacity:1; box-shadow:0 0 0 0 rgba(45,122,45,0); }
}
.kzc-success-check { font-size:38px;color:#fff; }
.kzc-success-title { font-size:20px;font-weight:800;color:#1c1c1c;text-align:center; }
.kzc-success-sub { font-size:14px;color:#5a4a30;text-align:center;line-height:1.6;max-width:280px; }

/* ── POPUP RÉCAPITULATIF ── */
.kzp-overlay {
  display:none;position:fixed;inset:0;
  background:rgba(0,0,0,0.6);z-index:9998;
  align-items:center;justify-content:center;padding:20px;
  backdrop-filter:blur(3px);
}
.kzp-overlay.kzp-open { display:flex; }
.kzp-modal {
  background:#fff;border-radius:20px;padding:26px;
  max-width:480px;width:100%;max-height:90vh;overflow-y:auto;
  box-shadow:0 12px 60px rgba(0,0,0,0.2);animation:kzp-in .25s ease;
}
@keyframes kzp-in { from{transform:scale(.95);opacity:0} to{transform:scale(1);opacity:1} }
.kzp-title { font-size:18px;font-weight:700;color:#1c1c1c;margin-bottom:18px; }
.kzp-section { margin-bottom:14px; }
.kzp-section-title {
  font-size:10px;font-weight:700;letter-spacing:1.2px;
  text-transform:uppercase;color:#c9a96e;margin-bottom:8px;
}
.kzp-row {
  display:flex;justify-content:space-between;align-items:flex-start;
  gap:12px;padding:6px 0;border-bottom:1px solid #f0ece7;font-size:13px;
}
.kzp-label { color:#8a8078;flex-shrink:0; }
.kzp-val { color:#1c1c1c;font-weight:500;text-align:right; }
.kzp-btns { display:flex;gap:10px;margin-top:20px; }
.kzp-btn-cancel {
  flex:1;padding:13px;border:1.5px solid #e0dbd4;border-radius:12px;
  background:#fff;font-size:14px;font-weight:600;cursor:pointer;
  font-family:inherit;color:#5a5249;transition:background .15s;
}
.kzp-btn-cancel:hover { background:#f8f6f2; }
.kzp-btn-confirm {
  flex:2;padding:13px;border:none;border-radius:12px;
  background:linear-gradient(135deg,#1c1c1c,#2d2d2d);color:#fff;
  font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;
  transition:opacity .15s;
}
@media (max-width:480px) {
  .kzp-btn-cancel, .kzp-btn-confirm { font-size:12px; padding:12px 6px; white-space:nowrap; }
}
.kzp-btn-confirm:hover { opacity:.88; }
.kzp-img-preview {
  display:block;max-width:100%;max-height:160px;
  border-radius:10px;margin:0 auto 12px;
  object-fit:contain;border:1px solid #e0dbd4;
  background:#f0ede8;
}

/* ── BANDEAU « COMMENT ÇA MARCHE » (3 cartes, non numéroté) ── */
.kzc-how-heading {
  font-size:13.5px;font-weight:700;color:#1c1c1c;margin-top:6px;margin-bottom:10px;
}
.kzc-how {
  display:grid;grid-template-columns:repeat(3,1fr);gap:12px;
}
.kzc-how-card {
  position:relative;display:flex;flex-direction:column;align-items:center;
  text-align:center;gap:9px;padding:16px 10px;
  background:linear-gradient(160deg,#fffdf9,#f8f2e6);
  border:1px solid rgba(201,169,110,0.4);border-radius:16px;
  box-shadow:0 2px 10px rgba(201,169,110,0.10);
}
.kzc-how-card:not(:last-child)::after {
  content:'→';position:absolute;right:-10px;top:50%;transform:translateY(-50%);
  color:#c9a96e;font-weight:800;font-size:18px;z-index:2;
}
.kzc-how-badge {
  width:50px;height:50px;border-radius:50%;display:flex;
  align-items:center;justify-content:center;font-size:24px;
  background:linear-gradient(135deg,#e8c87a,#c9a96e);
  box-shadow:0 4px 14px rgba(201,169,110,0.4);
}
.kzc-how-label { font-size:15px;font-weight:800;color:#1c1c1c;line-height:1.15; }
.kzc-how-desc { font-size:11.5px;color:#8a8078;line-height:1.35; }
@media (max-width:560px) {
  .kzc-how { grid-template-columns:1fr;gap:9px; }
  .kzc-how-card {
    flex-direction:row;align-items:center;text-align:left;gap:14px;padding:13px 16px;
  }
  .kzc-how-badge { flex-shrink:0;width:44px;height:44px;font-size:21px; }
  .kzc-how-label { font-size:15px; }
  .kzc-how-desc { font-size:12px; }
  .kzc-how-card:not(:last-child)::after {
    content:'↓';right:auto;left:35px;top:auto;bottom:-9px;transform:translateX(-50%);
  }
}

/* ── MENU DÉROULANT « OPTIONS AVANCÉES » ── */
.kzc-adv { margin:8px 0 14px; }
.kzc-adv-summary {
  cursor:pointer;font-size:12px;font-weight:700;color:#7a9e7e;
  letter-spacing:0.4px;list-style:none;user-select:none;padding:2px 0;
}
.kzc-adv-summary::-webkit-details-marker { display:none; }
.kzc-adv-summary::before { content:'▸ ';color:#c9a96e; }
.kzc-adv[open] .kzc-adv-summary::before { content:'▾ '; }
.kzc-adv-hint { font-weight:400;color:#8a8078;font-style:italic;letter-spacing:0; }
.kzc-adv > .kzc-field { margin-top:12px; }
</style>

<!-- Loading overlay -->
<div id="kzc-loading-overlay" class="kzc-loading-overlay">
  <div style="display:flex;align-items:center;gap:10px;width:220px;">
    <div class="kzc-loading-bar-wrap" style="flex:1;"><div id="kzc-loading-bar" class="kzc-loading-bar"></div></div>
    <span id="kzc-loading-pct" style="font-size:12px;color:#c9a96e;font-weight:700;min-width:36px;text-align:right;">0%</span>
  </div>
  <span id="kzc-loading-txt" class="kzc-loading-txt kzc-loading-pulse">Préparation de votre commande…</span>
</div>

<!-- Popup récapitulatif -->
<div id="kzp-overlay" class="kzp-overlay">
  <div class="kzp-modal">
    <div class="kzp-title">✅ Récapitulatif de votre commande</div>
    <div id="kzp-body"></div>
    <div class="kzp-btns">
      <button class="kzp-btn-cancel" id="kzp-cancel">← Modifier</button>
      <button class="kzp-btn-confirm" id="kzp-confirm">Confirmer ma commande →</button>
    </div>
  </div>
</div>

<!-- Erreur timeout -->
<div id="kzc-timeout-error">
  <div class="kzc-error-circle"><span class="kzc-error-icon">⚠️</span></div>
