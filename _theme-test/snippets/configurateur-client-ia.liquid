      errMsg.style.display='none';
      try { navigator.clipboard.writeText(p).catch(function(){}); } catch(e){}
      window.open(url,'_blank');
      setTimeout(function(){ openCard('kzc-card-2'); }, 800);
    }

    // ── BOUTON COPIER ──
    var copyWrap=document.createElement('div'); copyWrap.className='kzc-copy-btn-wrap';
    var bCopyOnly=document.createElement('button'); bCopyOnly.type='button';
    bCopyOnly.className='kzc-copy-main-btn';
    bCopyOnly.innerHTML='📋 Copier mon texte pour l\'IA';
    var successMsg=document.createElement('div'); successMsg.className='kzc-copy-success-msg';
    successMsg.innerHTML='✓ Texte copié ! Collez-le dans votre IA (ChatGPT, Google Gemini…), récupérez l’image, puis importez-la ici.';
    var hintMsg=document.createElement('p'); hintMsg.className='kzc-copy-hint';
    hintMsg.textContent='KuZcup AI fonctionne avec Gemini, ChatGPT, Mistral, et toutes les IA.';
    bCopyOnly.addEventListener('click',function(){
      var txt=buildPrompt();
      if(!txt){
        bCopyOnly.classList.add('invalid');
        var origHtml=bCopyOnly.innerHTML;
        bCopyOnly.innerHTML='⚠️ Remplissez les champs requis';
        setTimeout(function(){bCopyOnly.classList.remove('invalid');bCopyOnly.innerHTML=origHtml;},3000);
        return;
      }
      function afterCopy(){
        bCopyOnly.classList.add('copied');
        bCopyOnly.innerHTML='✓ Copié !';
        successMsg.classList.add('visible');
        setTimeout(function(){
          bCopyOnly.classList.remove('copied');
          bCopyOnly.innerHTML='📋 Copier mon texte pour l\'IA';
          successMsg.classList.remove('visible');
        },3500);
      }
      if(navigator.clipboard){navigator.clipboard.writeText(txt).then(afterCopy).catch(function(){var ta=document.createElement('textarea');ta.value=txt;document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);afterCopy();});}
      else{var ta=document.createElement('textarea');ta.value=txt;document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);afterCopy();}
    });
    var reassure=document.createElement('p'); reassure.className='kzc-copy-hint';
    reassure.style.cssText='color:#7a9e7e;font-weight:600;margin-top:8px;';
    reassure.textContent='✓ Pas besoin de savoir dessiner · Aperçu 3D avant commande · Vérifié avant impression';
    copyWrap.appendChild(bCopyOnly); copyWrap.appendChild(successMsg); copyWrap.appendChild(hintMsg); copyWrap.appendChild(reassure);
