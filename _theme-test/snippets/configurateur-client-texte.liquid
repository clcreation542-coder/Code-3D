  function kzpOpen(){
    var overlay=document.getElementById('kzp-overlay');if(!overlay) return;
    var productTitle={{ product.title | json }};
    var variants=getVariants();
    var qteVariant=null;
    variants.forEach(function(v){if(/quant/i.test(v.label)) qteVariant=v;});
    var prodRows='<div class="kzp-row"><span class="kzp-label">Produit</span><span class="kzp-val">'+productTitle+'</span></div>';
    if(qteVariant) prodRows+='<div class="kzp-row"><span class="kzp-label">'+qteVariant.label+'</span><span class="kzp-val">'+qteVariant.value+'</span></div>';
    document.getElementById('kzp-prod-rows').innerHTML=prodRows;

    var persoRows='';
    if(S.av.t[0].trim()) persoRows+='<div class="kzp-row"><span class="kzp-label">Face avant ligne 1</span><span class="kzp-val">'+S.av.t[0].trim()+'</span></div>';
    if(S.av.t[1].trim()) persoRows+='<div class="kzp-row"><span class="kzp-label">Face avant ligne 2</span><span class="kzp-val">'+S.av.t[1].trim()+'</span></div>';
    if(S.av.t[2].trim()) persoRows+='<div class="kzp-row"><span class="kzp-label">Face avant ligne 3</span><span class="kzp-val">'+S.av.t[2].trim()+'</span></div>';
    if(S.av.imgName)     persoRows+='<div class="kzp-row"><span class="kzp-label">Logo face avant</span><span class="kzp-val">\u2705 '+S.av.imgName+'</span></div>';
    if(S.ar.t[0].trim()) persoRows+='<div class="kzp-row"><span class="kzp-label">Face arri\u00e8re ligne 1</span><span class="kzp-val">'+S.ar.t[0].trim()+'</span></div>';
    if(S.ar.t[1].trim()) persoRows+='<div class="kzp-row"><span class="kzp-label">Face arri\u00e8re ligne 2</span><span class="kzp-val">'+S.ar.t[1].trim()+'</span></div>';
    if(S.ar.imgName)     persoRows+='<div class="kzp-row"><span class="kzp-label">Logo arri\u00e8re</span><span class="kzp-val">\u2705 '+S.ar.imgName+'</span></div>';
    if(S.eventDate)      persoRows+='<div class="kzp-row"><span class="kzp-label">Date \u00e9v\u00e9nement</span><span class="kzp-val">'+S.eventDate+'</span></div>';

    var ps=document.getElementById('kzp-perso-section');
    if(persoRows){document.getElementById('kzp-perso-rows').innerHTML=persoRows;ps.style.display='';}
    else{ps.style.display='none';}
    overlay.classList.add('kzp-visible');
    document.body.style.overflow='hidden';
  }

  function kzpClose(){
    var overlay=document.getElementById('kzp-overlay');
    if(overlay) overlay.classList.remove('kzp-visible');
    document.body.style.overflow='';
  }

  function interceptCartButton(){
    document.addEventListener('click',function(e){
      var btn=e.target.closest('button[type="submit"][is="custom-button"]');
      if(!btn) return;
      e.preventDefault();e.stopImmediatePropagation();
      updateLineItemProps();kzpOpen();
    },true);

    var overlay=document.getElementById('kzp-overlay');
    var confirmBtn=document.getElementById('kzp-confirm-btn');
    var cancelBtn=document.getElementById('kzp-cancel-btn');
    if(cancelBtn) cancelBtn.addEventListener('click',kzpClose);
    if(overlay) overlay.addEventListener('click',function(e){if(e.target===this) kzpClose();});

    if(confirmBtn) confirmBtn.addEventListener('click',function(){
      if(window._kzcOrderDone) return;
      kzpClose();
      confirmBtn.disabled=true;confirmBtn.textContent='\u23f3 Pr\u00e9paration\u2026';
      var form=document.querySelector('form[action*="/cart/add"]');if(!form) return;

      if(window._kzcPending) return;
      if(window._kzcPngRequested) return;
      window._kzcPending=true;
      window._kzcPngRequested=true;
      var lo=document.getElementById('kzc-loading-overlay');
      var lb=document.getElementById('kzc-loading-bar');
      var ltxt=document.getElementById('kzc-loading-text');
      var pctEl=document.getElementById('kzc-loading-pct');
      if(lo) lo.classList.add('kzc-active');
      window._kzcLoadInterval=startLoadingAnimation(lb,ltxt,pctEl);

      // ── Boucle de réessai : redemande le PNG au GRAND iframe uniquement,
      //    toutes les 8 s, tant que le viewer n'est pas prêt / que le PNG
      //    n'est pas revenu. S'arrête dès réception de PRINT_PNG_READY.
      //    NOTE : l'ancienne branche « else { form.submit() } » qui laissait
      //    filer la commande sans PNG quand le viewer n'était pas prêt est
      //    supprimée. On ne soumet JAMAIS sans PNG.
      function requestPng(){
        if(!window._kzcPending) return;   // déjà résolu → on n'envoie plus rien
        if(!S.vReady) return;             // viewer pas encore prêt → on retentera au prochain tick
        if(iframe&&iframe.contentWindow) iframe.contentWindow.postMessage({type:'REQUEST_PRINT_PNG',proxyUrl:PROXY_URL,proxyKey:PROXY_KEY,origin:'texte'},'*');
      }
      requestPng();                        // tentative immédiate
      window._kzcRetryInterval=setInterval(requestPng,8000);

      // Timeout 60s — si pas de PNG → erreur, la commande ne part PAS
      window._kzcTimeout=setTimeout(function(){
        if(window._kzcPending){
          window._kzcPending=false;
          clearInterval(window._kzcLoadInterval);
          clearInterval(window._kzcRetryInterval);
          if(lo) lo.classList.remove('kzc-active');
          showError();
        }
      },60000);
    });
  }

  function initCropBar(){
    ['kcb-slider','kcb-zm','kcb-zp','kcb-l','kcb-r','kcb-u','kcb-d'].forEach(function(bid){
      var bb=document.getElementById(bid);if(!bb) return;
      if(bid==='kcb-slider'){
        bb.addEventListener('input',function(){if(!S[S.face].cropState) S[S.face].cropState={zoom:1,ox:0,oy:0};S[S.face].cropState.zoom=parseInt(this.value)/100;renderAll();});
      } else {
        bb.addEventListener('click',function(){
          if(!S[S.face].cropState) S[S.face].cropState={zoom:1,ox:0,oy:0};
          var c=S[S.face].cropState;
          if(bid==='kcb-zm') c.zoom=Math.max(0.5,c.zoom-.1);
          if(bid==='kcb-zp') c.zoom=Math.min(3,c.zoom+.1);
          if(bid==='kcb-l')  c.ox-=CSTEP;if(bid==='kcb-r') c.ox+=CSTEP;
          if(bid==='kcb-u')  c.oy-=CSTEP;if(bid==='kcb-d') c.oy+=CSTEP;
          var sl=document.getElementById('kcb-slider');if(sl) sl.value=Math.round(c.zoom*100);
          renderAll();
        });
      }
    });
    var kcbOk=document.getElementById('kcb-ok');
    if(kcbOk) kcbOk.addEventListener('click',function(){var cropBar=document.getElementById('kzc-crop-bar');if(cropBar) cropBar.style.display='none';});
  }

  function maskContenance(){
    document.querySelectorAll('.variant-picker__option,fieldset').forEach(function(fs){
      var leg=fs.querySelector('legend,.variant-picker__option-info');
      if(leg&&/contenance/i.test(leg.textContent)) fs.style.setProperty('display','none','important');
    });
  }
  setTimeout(maskContenance,200);setTimeout(maskContenance,600);setTimeout(maskContenance,1200);
  var _mc=new MutationObserver(function(){maskContenance();});
  _mc.observe(document.body,{childList:true,subtree:true});

