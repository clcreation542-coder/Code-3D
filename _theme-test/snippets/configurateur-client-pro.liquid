  function updateBars(){
    [['av',3],['ar',2]].forEach(function(p){
      var face=p[0],nb=p[1];
      for(var i=1;i<=nb;i++){
        var ta=document.getElementById('kzc-'+face+i);
        var bar=document.getElementById('kzc-cb-'+face+i);
        var warn=document.getElementById('kzc-cw-'+face+i);
        if(!ta||!bar) continue;
        bar.style.width=Math.min(ta.value.length/40*100,100)+'%';
        if(ta.value.trim()){
          var tz=textZones(face,!!S[face].img,S[face].iz);
          if(tz[i-1]){var fs=calcFs(tz[i-1],ta.value,S[face].ff);bar.style.background=fs<MIN_FS?'#C0392B':fs<MIN_FS*1.5?'#e8a020':'#C9A96E';if(warn) warn.style.display=fs<MIN_FS?'block':'none';}
        } else {bar.style.width='0';if(warn) warn.style.display='none';}
      }
    });
  }

  function checkBg(src,cb){
    var img=new Image();
    img.onload=function(){
      var cv=document.createElement('canvas');cv.width=Math.min(img.naturalWidth,200);cv.height=Math.min(img.naturalHeight,200);
      var ctx=cv.getContext('2d');ctx.drawImage(img,0,0,cv.width,cv.height);
      var pts=[[0,0],[cv.width-1,0],[0,cv.height-1],[cv.width-1,cv.height-1],[Math.floor(cv.width/2),0],[0,Math.floor(cv.height/2)]];
      var wc=0,ta=0;
      pts.forEach(function(p){var d=ctx.getImageData(p[0],p[1],1,1).data;ta+=d[3];if(d[0]>240&&d[1]>240&&d[2]>240&&d[3]>200)wc++;});
      cb(wc>=3||(ta/pts.length)>240);
    };
    img.onerror=function(){cb(false);};img.src=src;
  }

  function checkPhotoQuality(w,h,msgEl){
    if(!msgEl) return;msgEl.style.display='none';
    var base='display:block;padding:8px 12px;border-radius:8px;font-size:12px;margin-top:6px;';
    if(w<PHOTO_MIN_PX||h<PHOTO_MIN_PX){msgEl.textContent='Cette photo est trop petite pour une impression de qualité. Veuillez en choisir une autre.';msgEl.style.cssText=base+'background:#fffaf2;border:1.5px solid #c9a96e;color:#7a5c2e;';}
    else if(w<PHOTO_WARN_PX||h<PHOTO_WARN_PX){msgEl.textContent='Votre photo est de faible résolution. Le résultat imprimé risque d\'être flou.';msgEl.style.cssText=base+'background:#fffaf2;border:1.5px solid #c9a96e;color:#7a5c2e;';}
  }

