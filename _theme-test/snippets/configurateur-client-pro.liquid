    // ── Prompt IA pro — court et séparé (événement / date sur lignes distinctes) ──
    function buildAIPrompt(){
      var entreprise=(document.getElementById('kzc-ia-entreprise')||{value:''}).value.trim();
      var date=(document.getElementById('kzc-ia-date')||{value:''}).value.trim();
      var occSel=(document.getElementById('kzc-ia-occasion')||{value:''}).value.trim();
      var occAutre=(document.getElementById('kzc-ia-occasion-autre')||{value:''}).value.trim();
      var detail=(document.getElementById('kzc-ia-detail')||{value:''}).value.trim();
      var theme=(document.getElementById('kzc-ia-theme')||{value:''}).value.trim();
      var couleurs=(document.getElementById('kzc-ia-couleurs')||{value:''}).value.trim();
      var occasion=(occSel==='Autre')?occAutre:occSel;
      var err=document.getElementById('kzc-ia-err');
      if(!err){err=document.createElement('p');err.id='kzc-ia-err';err.style.cssText='font-size:12px;color:#c0392b;margin-top:6px;text-align:center;';var btns=document.querySelector('.kzc-ai-btns');if(btns) btns.parentNode.insertBefore(err,btns.nextSibling);}
      if(!entreprise||!occasion||!theme){err.textContent='Merci de remplir au minimum : nom de l\'entreprise/association, occasion et thème visuel.';return null;}
      err.textContent='';
      var occasionFinale=occasion+(detail?' — '+detail:'');
      var lignes=[];
      lignes.push('Génère une image décorative au format paysage exact 1970×1140px, fond blanc pur (#FFFFFF), pour impression sur gobelet réutilisable.');
      lignes.push('');
      lignes.push('Thème : '+theme+(couleurs?' — couleurs : '+couleurs:''));
      lignes.push('');
      lignes.push('Intègre ces textes UNE SEULE FOIS chacun, centrés dans la composition :');
      lignes.push('- "'+entreprise+'"');
      lignes.push('- "'+occasionFinale+'"');
      if(date) lignes.push('- "'+date+'"');
      lignes.push('');
      lignes.push('Règles :');
      lignes.push('- Fond blanc uni #FFFFFF avec éléments graphiques colorés et expressifs');
      lignes.push('- Format 1.73:1 (1970×1140px), marges 5% sur tous les bords');
      lignes.push('- INTERDIT : ne reproduis jamais un logo de club sportif (PSG, OM, Real Madrid...), un personnage protégé (Disney, Marvel, Harry Potter...) ou une marque déposée (Nike, Adidas...). Si le thème s\'en approche, crée une alternative graphique originale dans le même esprit.');
      lignes.push('- Chaque texte apparaît UNE SEULE FOIS, intégré naturellement dans le design');
      lignes.push('- Aucun filigrane, cadre ou copyright');
      lignes.push('- Réponds uniquement avec l\'image, sans texte explicatif.');
      return lignes.join('\n');
    }

    function copyAndOpen(url,btn){
      var txt=buildAIPrompt();if(!txt) return;
      var originalLabel=btn.innerHTML;
      function afterCopy(){btn.innerHTML='✅ Copié — collez-le dans la conversation !';setTimeout(function(){btn.innerHTML=originalLabel;},3500);}
      window.open(url,'_blank','noopener,noreferrer');
      if(navigator.clipboard){navigator.clipboard.writeText(txt).then(afterCopy).catch(function(){var ta=document.createElement('textarea');ta.value=txt;document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);afterCopy();});}
      else{var ta=document.createElement('textarea');ta.value=txt;document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);afterCopy();}
    }

    setTimeout(function(){
      var btnCopyOnly=document.getElementById('kzc-copy-only');
      var successMsgEl=document.getElementById('kzc-copy-success-msg');
      if(btnCopyOnly) btnCopyOnly.addEventListener('click',function(){
        var txt=buildAIPrompt();
        if(!txt){
          btnCopyOnly.classList.add('invalid');
          var origHtml=btnCopyOnly.innerHTML;
          btnCopyOnly.innerHTML='\u26a0\ufe0f Remplissez les champs requis';
          setTimeout(function(){btnCopyOnly.classList.remove('invalid');btnCopyOnly.innerHTML=origHtml;},3000);
          return;
        }
        function afterCopy(){
          btnCopyOnly.classList.add('copied');
          btnCopyOnly.innerHTML='<span class="kzc-btn-icon">\u2713</span> Prompt copi\u00e9 !';
          if(successMsgEl) successMsgEl.classList.add('visible');
          setTimeout(function(){
            btnCopyOnly.classList.remove('copied');
            btnCopyOnly.innerHTML='\ud83d\udccb Copier mon texte pour l\'IA';
            if(successMsgEl) successMsgEl.classList.remove('visible');
          },3500);
        }
        if(navigator.clipboard){navigator.clipboard.writeText(txt).then(afterCopy).catch(function(){var ta=document.createElement('textarea');ta.value=txt;document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);afterCopy();});}
        else{var ta=document.createElement('textarea');ta.value=txt;document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);afterCopy();}
      });
    },800);

    goStep(1);

    function doInject(t){
      if(document.contains(container)) return;
      var priceBlock=t.querySelector('[data-block-type="price"]');
      if(priceBlock){t.insertBefore(container,priceBlock);}
      else{var titleBlock=t.querySelector('[data-block-type="title"]');if(titleBlock&&titleBlock.nextSibling){t.insertBefore(container,titleBlock.nextSibling);}else{t.prepend(container);}}
    }
    function inject(){
      var target=document.querySelector('.product-info');if(target){doInject(target);return;}
      var observer=new MutationObserver(function(ml,obs){var t=document.querySelector('.product-info');if(t){obs.disconnect();doInject(t);}});
      observer.observe(document.body,{childList:true,subtree:true});
      [300,600,1000,2000,4000].forEach(function(delay){setTimeout(function(){if(document.contains(container)) return;var t=document.querySelector('.product-info')||document.querySelector('safe-sticky');if(t){observer.disconnect();doInject(t);}},delay);});
    }
    inject();
  }

  function interceptCartButton(){
    document.addEventListener('click',function(e){
      var btn=e.target.closest('button[type="submit"][is="custom-button"]');
      if(!btn) return;
      e.preventDefault();e.stopImmediatePropagation();updateLineItemProps();kzpOpen();
    },true);

    var overlay=document.getElementById('kzp-overlay');
    var confirmBtn=document.getElementById('kzp-confirm-btn');
    var cancelBtn=document.getElementById('kzp-cancel-btn');
    if(cancelBtn) cancelBtn.addEventListener('click',kzpClose);
    if(overlay) overlay.addEventListener('click',function(e){if(e.target===this) kzpClose();});

    if(confirmBtn) confirmBtn.addEventListener('click',function(){
      if(window._kzcOrderDone) return;
      kzpClose();confirmBtn.disabled=true;confirmBtn.textContent='⏳ Préparation de votre commande…';
      var form=document.querySelector('form[action*="/cart/add"]');if(!form) return;

      if((S.parcours==='ia'||S.parcours==='canva')&&!S.cImg){
        var msgEl=document.getElementById('kzc-no-design-msg');
        if(!msgEl){msgEl=document.createElement('div');msgEl.id='kzc-no-design-msg';msgEl.style.cssText='position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:#1c1c1c;color:#fff;padding:12px 20px;border-radius:10px;font-size:14px;z-index:30000;text-align:center;max-width:340px;';msgEl.textContent='Votre design n\'a pas encore été importé — ajoutez votre image pour continuer.';document.body.appendChild(msgEl);setTimeout(function(){if(msgEl.parentNode) msgEl.parentNode.removeChild(msgEl);},3500);}
        confirmBtn.disabled=false;confirmBtn.textContent='Confirmer ma commande →';return;
      }

      if(window._kzcPending) return;
      if(window._kzcPngRequested) return;
      window._kzcPending=true;
      window._kzcPngRequested=true;
      var loadOv=document.getElementById('kzc-loading-overlay');
      var loadBar=document.getElementById('kzc-loading-bar');
      var loadTxt=document.getElementById('kzc-loading-text');
      var pctEl=document.getElementById('kzc-loading-pct');
      if(loadOv) loadOv.classList.add('kzc-active');
      window._kzcLoadInterval=startLoadingAnimation(loadBar,loadTxt,pctEl);

      // ── Boucle de réessai : redemande le PNG au GRAND iframe uniquement,
      //    toutes les 8 s, tant que le viewer n'est pas prêt / que le PNG
      //    n'est pas revenu. S'arrête dès réception de PRINT_PNG_READY.
      //    NOTE : l'ancienne branche « else { form.submit() } » qui laissait
      //    filer la commande sans PNG quand le viewer n'était pas prêt est
      //    supprimée. On ne soumet JAMAIS sans PNG.
      function requestPng(){
        if(!window._kzcPending) return;   // déjà résolu → on n'envoie plus rien
        if(!S.vReady) return;             // viewer pas encore prêt → on retentera au prochain tick
        if(iframe&&iframe.contentWindow) iframe.contentWindow.postMessage({type:'REQUEST_PRINT_PNG',proxyUrl:PROXY_URL,proxyKey:PROXY_KEY,origin:'pro'},'*');
      }
      requestPng();                        // tentative immédiate
      window._kzcRetryInterval=setInterval(requestPng,8000);

      // Timeout 60s — si pas de PNG → erreur, la commande ne part PAS
      window._kzcTimeout=setTimeout(function(){
        if(window._kzcPending){window._kzcPending=false;clearInterval(window._kzcLoadInterval);clearInterval(window._kzcRetryInterval);if(loadOv) loadOv.classList.remove('kzc-active');showError();}
      },60000);
    });
  }

  function init(){
    var link=document.createElement('link');link.rel='stylesheet';
    link.href='https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Playfair+Display:wght@400;700&family=Cormorant+Garamond:wght@400;600&display=swap';
    document.head.appendChild(link);

    var CSTEP=20;
    var kcbSlider=document.getElementById('kcb-slider');
    if(kcbSlider) kcbSlider.addEventListener('input',function(){if(!S[S.face].cropState) S[S.face].cropState={zoom:1,ox:0,oy:0};S[S.face].cropState.zoom=parseInt(this.value)/100;renderAll();});
    ['kcb-zm','kcb-zp','kcb-l','kcb-r','kcb-u','kcb-d'].forEach(function(bid){
      var bb=document.getElementById(bid);if(!bb) return;
      bb.addEventListener('click',function(){
        if(!S[S.face].cropState) S[S.face].cropState={zoom:1,ox:0,oy:0};
        var c=S[S.face].cropState;
        if(bid==='kcb-zm') c.zoom=Math.max(0.5,c.zoom-0.1);if(bid==='kcb-zp') c.zoom=Math.min(3,c.zoom+0.1);
        if(bid==='kcb-l') c.ox-=CSTEP;if(bid==='kcb-r') c.ox+=CSTEP;
        if(bid==='kcb-u') c.oy-=CSTEP;if(bid==='kcb-d') c.oy+=CSTEP;
        var sl=document.getElementById('kcb-slider');if(sl) sl.value=Math.round(c.zoom*100);renderAll();
      });
    });
    var kcbOk=document.getElementById('kcb-ok');
    if(kcbOk) kcbOk.addEventListener('click',function(){var cropBar=document.getElementById('kzc-crop-bar');if(cropBar) cropBar.style.display='none';});

    buildForm();
    var src=VIEWER_BASE+'?v='+Date.now();
    if(iframe) iframe.src=src; _kzMiniSrc=src;
    interceptCartButton();
  }

  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init);}
  else{init();}

  // Masquer la Contenance
  function maskContenance(){
    var fieldsets=document.querySelectorAll('.variant-picker__option,fieldset');
    fieldsets.forEach(function(fs){
      var legend=fs.querySelector('legend,.variant-picker__option-info');
      if(legend&&legend.textContent.indexOf('Contenance')!==-1) fs.style.setProperty('display','none','important');
    });
    var selects=document.querySelectorAll('select');
    selects.forEach(function(sel){
      if(sel.id==='kzc-ia-occasion') return;
      var parent=sel.parentElement;
      while(parent){
        if(parent.textContent.indexOf('Contenance')!==-1&&parent.textContent.indexOf('Quantité')===-1){parent.style.setProperty('display','none','important');break;}
        if(parent.classList&&parent.classList.contains('product-info')) break;
        parent=parent.parentElement;
      }
    });
  }
  setTimeout(maskContenance,200);setTimeout(maskContenance,600);setTimeout(maskContenance,1200);
  var _mcObs=new MutationObserver(function(){maskContenance();});
  _mcObs.observe(document.body,{childList:true,subtree:true});

})();
</script>
